#!/usr/bin/env bash
# pmai-install — Install PMAI framework (global only)
#
# 全局安装：clone 远程到 ~/.pmai/ + symlink 当前 skill 到 host skill dirs
# 装一次，任意 cwd 可用 /pmai-* skill。
#
# 注：旧的 `--local <dir>`（往项目 .claude/ 拷实体副本）已移除——它和全局安装并存时
#     会让每个 /pmai-* 命令在菜单里重复，且副本不跟随升级而变陈旧。skill 一律走全局，
#     项目里只放主控 host 配置 / 状态资产（.claude/settings.json / .codex/hooks.json / .work-meta.json）。
#     清理遗留的项目副本：`pmai uninstall --local <dir>`。

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../scripts/_lib/skill-links.sh"
source "$SCRIPT_DIR/../scripts/_lib/global-install-lock.sh"
ORIGINAL_ARGS=("$@")

REMOTE="${PMAI_REMOTE:-git@github.com:YYG501/PMAI_Workflow.git}"
PMAI_HOME="${PMAI_HOME:-$HOME/.pmai}"
CLAUDE_SKILLS="$HOME/.claude/skills"
CODEX_SKILLS="${CODEX_HOME:-$HOME/.codex}/skills"
CODEX_PROMPTS="${CODEX_HOME:-$HOME/.codex}/prompts"
SKILL_PREFIX="pmai-"

usage() {
  cat <<EOF
Usage:
  pmai install                # Global: clone → ~/.pmai/ + symlink host skills

Env override:
  PMAI_REMOTE=<git-url>       # Override default github remote
  PMAI_HOME=<path>            # Override default ~/.pmai/
  CODEX_HOME=<path>           # Override default ~/.codex
Notes:
  - Skills get 'pmai-' prefix at registration (e.g., /pmai-init-project).
  - skills/_shared/ is a shared resource (not a skill); skipped from prefix routing
    but still linked alongside other skills so SKILL.md cross-refs work.
  - skills/_internal/ is implementation detail; it is not exposed as /pmai-*.
EOF
}

case "${1:-}" in
  --help|-h) usage; exit 0 ;;
  "") ;;
  *) echo "❌ unknown flag: $1" >&2; usage >&2; exit 2 ;;
esac

pmai_hold_global_install_lock \
  "$SCRIPT_DIR/.." "${BASH_SOURCE[0]}" \
  ${ORIGINAL_ARGS[@]+"${ORIGINAL_ARGS[@]}"}

load_target_skill_link_policy() {
  local helper="$1"

  unset -f pmai_skill_is_host_exposed pmai_prune_managed_hidden_skill_links \
    pmai_count_managed_hidden_skill_links pmai_skill_link_is_managed \
    2>/dev/null || true
  if [ -f "$helper" ]; then
    source "$helper"
  fi
  if ! declare -F pmai_skill_is_host_exposed >/dev/null; then
    pmai_skill_is_host_exposed() { return 0; }
  fi
}

TX_ACTIVE=0
TX_CLONE_CREATED=0
TX_PATHS=()
TX_BACKUPS=()
INSTALL_DOCTOR_LOG=""

transaction_has_path() {
  local candidate="$1"
  local existing
  for existing in ${TX_PATHS[@]+"${TX_PATHS[@]}"}; do
    [ "$existing" = "$candidate" ] && return 0
  done
  return 1
}

snapshot_entry() {
  local path="$1"
  local backup=""
  local parent

  transaction_has_path "$path" && return 0
  if [ -e "$path" ] || [ -L "$path" ]; then
    parent=$(dirname "$path")
    backup="$parent/.pmai-install-backup.$$.$RANDOM.${#TX_PATHS[@]}"
    while [ -e "$backup" ] || [ -L "$backup" ]; do
      backup="$parent/.pmai-install-backup.$$.$RANDOM.${#TX_PATHS[@]}"
    done
  fi
  # Register both fields before rename. A signal before rename keeps the
  # original path; a signal after rename can always find its backup.
  TX_BACKUPS+=("$backup")
  TX_PATHS+=("$path")
  if [ -n "$backup" ]; then
    mv -- "$path" "$backup"
  fi
  return 0
}

snapshot_install_surfaces() {
  local dst_skills old skill_dir skill_name dst

  for dst_skills in "$CLAUDE_SKILLS" "$CODEX_SKILLS"; do
    mkdir -p "$dst_skills"
    for old in "$dst_skills"/${SKILL_PREFIX}*; do
      [ -L "$old" ] || continue
      snapshot_entry "$old"
    done
    for skill_dir in "$PMAI_HOME"/skills/*/; do
      [ -d "$skill_dir" ] || continue
      skill_name=$(basename "$skill_dir")
      case "$skill_name" in
        _internal) continue ;;
        _shared) dst="$dst_skills/_shared" ;;
        *)
          pmai_skill_is_host_exposed "$skill_name" || continue
          case "$skill_name" in
            pmai-*) dst="$dst_skills/$skill_name" ;;
            *) dst="$dst_skills/${SKILL_PREFIX}${skill_name}" ;;
          esac
          ;;
      esac
      snapshot_entry "$dst"
    done
  done

  legacy_prompt_count=0
  for old in "$CODEX_PROMPTS"/${SKILL_PREFIX}*.md; do
    [ -e "$old" ] || [ -L "$old" ] || continue
    snapshot_entry "$old"
    legacy_prompt_count=$((legacy_prompt_count + 1))
  done
}

install_rollback() {
  local exit_code="${1:-1}"
  local index path backup
  local rollback_failed=0

  TX_ACTIVE=0
  trap - ERR HUP INT TERM EXIT
  set +e
  echo "" >&2
  echo "❌ PMAI 安装失败，正在恢复安装前状态..." >&2
  for ((index=${#TX_PATHS[@]} - 1; index >= 0; index--)); do
    path="${TX_PATHS[$index]}"
    backup="${TX_BACKUPS[$index]}"
    if [ -n "$backup" ]; then
      if [ -e "$backup" ] || [ -L "$backup" ]; then
        if { [ -e "$path" ] || [ -L "$path" ]; } \
          && ! rm -rf -- "$path"; then
          echo "⚠️  无法移除失败安装入口，原备份保留在：$backup" >&2
          rollback_failed=1
          continue
        fi
        if ! mv -- "$backup" "$path"; then
          echo "⚠️  无法恢复安装入口，备份保留在：$backup" >&2
          rollback_failed=1
        fi
      else
        echo "⚠️  安装入口备份缺失，保留当前路径避免二次丢失：$path" >&2
        rollback_failed=1
      fi
    elif { [ -e "$path" ] || [ -L "$path" ]; } \
      && ! rm -rf -- "$path"; then
      echo "⚠️  无法移除本轮新建入口：$path" >&2
      rollback_failed=1
    fi
  done
  if [ "$TX_CLONE_CREATED" = "1" ] \
    && { [ -e "$PMAI_HOME" ] || [ -L "$PMAI_HOME" ]; } \
    && ! rm -rf -- "$PMAI_HOME"; then
    echo "⚠️  无法移除失败安装创建的 framework：$PMAI_HOME" >&2
    rollback_failed=1
  fi
  if [ "$rollback_failed" = "1" ]; then
    echo "⚠️  安装回滚未完整；请按以上路径保留并核对恢复材料。" >&2
  fi
  if [ -n "$INSTALL_DOCTOR_LOG" ] && [ -f "$INSTALL_DOCTOR_LOG" ]; then
    echo "   doctor 日志保留在：$INSTALL_DOCTOR_LOG" >&2
  fi
  exit "$exit_code"
}

install_exit_guard() {
  local exit_code="$?"

  if [ "$TX_ACTIVE" = "1" ]; then
    [ "$exit_code" -ne 0 ] || exit_code=1
    install_rollback "$exit_code"
  fi
}

install_failure_guard() {
  local exit_code="$1"

  if [ "$TX_ACTIVE" = "1" ]; then
    install_rollback "$exit_code"
  fi
  trap - ERR HUP INT TERM EXIT
  exit "$exit_code"
}

commit_install_transaction() {
  local backup

  TX_ACTIVE=0
  trap - ERR HUP INT TERM EXIT
  for backup in ${TX_BACKUPS[@]+"${TX_BACKUPS[@]}"}; do
    [ -n "$backup" ] || continue
    if { [ -e "$backup" ] || [ -L "$backup" ]; } \
      && ! rm -rf -- "$backup"; then
      echo "⚠️  安装已提交，但旧入口恢复材料未删除：$backup" >&2
    fi
  done
  if [ -n "$INSTALL_DOCTOR_LOG" ]; then
    if rm -f -- "$INSTALL_DOCTOR_LOG"; then
      INSTALL_DOCTOR_LOG=""
    else
      echo "⚠️  安装已提交，但 doctor 临时日志未删除：$INSTALL_DOCTOR_LOG" >&2
    fi
  fi
  return 0
}

# 子函数：把 src_skills 下的目录 symlink 到 dst_skills，加 pmai- 前缀
install_skills() {
  local src_skills="$1"
  local dst_skills="$2"
  local count=0

  mkdir -p "$dst_skills"
  for skill_dir in "$src_skills"/*/; do
    [ -d "$skill_dir" ] || continue
    skill_name=$(basename "$skill_dir")

    # _shared 不是 skill，但 SKILL.md 内部交叉引用 → 跟随链接但不加前缀
    # _internal 是 init-project 等公开入口的内部子流程集合 → 不暴露给 host
    # pmai-* 已带前缀的目录（如 skills/pmai-upgrade/）→ 不再加前缀（防双前缀 bug）
    case "$skill_name" in
      _internal) continue ;;
      _shared)  dst="$dst_skills/_shared" ;;
      *)
        pmai_skill_is_host_exposed "$skill_name" || continue
        case "$skill_name" in
          pmai-*) dst="$dst_skills/$skill_name" ;;
          *)      dst="$dst_skills/${SKILL_PREFIX}${skill_name}" ;;
        esac
        ;;
    esac

    if [ "$skill_name" = "_shared" ]; then
      pmai_install_shared_link "${skill_dir%/}" "$dst"
    else
      # pmai-* 是 PMAI 的专属命名空间；升级时替换旧入口。
      [ -e "$dst" ] || [ -L "$dst" ] && rm -rf "$dst"
      ln -s "${skill_dir%/}" "$dst"
    fi
    count=$((count + 1))
  done
  echo "   installed $count skill entries → $dst_skills"
}

check_gstack_readiness() {
  local gstack_bin version

  gstack_bin=$(command -v gstack 2>/dev/null || true)
  if [ -n "$gstack_bin" ]; then
    echo "✅ gstack command detected: $gstack_bin"
    return 0
  fi

  if [ -d "$HOME/.claude/skills/gstack" ]; then
    version=""
    if [ -f "$HOME/.claude/skills/gstack/VERSION" ]; then
      version=" ($(cat "$HOME/.claude/skills/gstack/VERSION" 2>/dev/null || echo unknown))"
    fi
    echo "✅ gstack skill detected: ~/.claude/skills/gstack$version"
    return 0
  fi

  echo "⚠️  gstack 未检测到：初始化不受影响；需要 Web 验收时可使用 gstack 或其它主动浏览器适配器"
  echo "   先安装 gstack：参考 https://github.com/garrytan/gstack"
  echo "   PMAI 已安装完成；/pmai-init-project 的任何分支都不因 gstack 阻塞。"
}

remove_managed_skill_symlinks() {
  local dst_skills="$1"
  local old

  mkdir -p "$dst_skills"
  for old in "$dst_skills"/${SKILL_PREFIX}*; do
    [ -L "$old" ] && rm "$old" || true
  done
}

remove_managed_codex_prompts() {
  local prompt_dir="$1"
  local old
  local count=0

  [ -d "$prompt_dir" ] || { echo "0"; return 0; }
  for old in "$prompt_dir"/${SKILL_PREFIX}*.md; do
    if [ -e "$old" ]; then
      rm -f "$old"
      count=$((count + 1))
    fi
  done
  echo "$count"
}

echo "→ Installing PMAI globally..."
for dst_skills in "$CLAUDE_SKILLS" "$CODEX_SKILLS"; do
  pmai_assert_shared_link_available "$PMAI_HOME/skills/_shared" "$dst_skills/_shared"
done
if [ -d "$PMAI_HOME/.git" ]; then
  echo "⚠️  $PMAI_HOME 已存在。要升级跑: pmai upgrade" >&2
  echo "   或先 pmai uninstall 清理后重装。" >&2
  exit 1
fi
if [ -e "$PMAI_HOME" ] || [ -L "$PMAI_HOME" ]; then
  echo "❌ $PMAI_HOME 存在但不是 git 仓。手动清理后重试。" >&2
  exit 1
fi

TX_ACTIVE=1
trap 'install_failure_guard 1' ERR
trap 'install_failure_guard 129' HUP
trap 'install_failure_guard 130' INT
trap 'install_failure_guard 143' TERM
trap 'install_exit_guard' EXIT

echo "→ git clone $REMOTE → $PMAI_HOME"
TX_CLONE_CREATED=1
git clone "$REMOTE" "$PMAI_HOME"
load_target_skill_link_policy "$PMAI_HOME/scripts/_lib/skill-links.sh"
snapshot_install_surfaces

echo "→ Symlink skills to host skill directories"
for dst_skills in "$CLAUDE_SKILLS" "$CODEX_SKILLS"; do
  remove_managed_skill_symlinks "$dst_skills"
  install_skills "$PMAI_HOME/skills" "$dst_skills"
done
echo "→ Remove legacy Codex slash prompts"
echo "   $CODEX_PROMPTS: $legacy_prompt_count legacy prompt file(s) removed"
DOCTOR_BIN="$PMAI_HOME/bin/pmai-doctor"
if [ ! -x "$DOCTOR_BIN" ]; then
  echo "❌ 安装目标的 pmai-doctor 缺失或不可执行：$DOCTOR_BIN" >&2
  install_rollback 1
fi
INSTALL_DOCTOR_LOG=$(mktemp "${TMPDIR:-/tmp}/pmai-install-doctor.XXXXXX")
echo "→ Running target pmai-doctor self-check..."
if ! PMAI_HOME="$PMAI_HOME" CODEX_HOME="${CODEX_HOME:-$HOME/.codex}" \
  "$DOCTOR_BIN" >"$INSTALL_DOCTOR_LOG" 2>&1; then
  echo "❌ 安装目标的 pmai-doctor 自检失败。" >&2
  tail -20 "$INSTALL_DOCTOR_LOG" >&2 || true
  install_rollback 1
fi
echo "  ✅ doctor passed"
commit_install_transaction

VER=$(cat "$PMAI_HOME/VERSION" 2>/dev/null || echo unknown)
echo ""
echo "═══════════════════════════════════════"
echo "✅ PMAI v$VER installed globally"
echo "   ~/.pmai/         framework source"
echo "   ~/.claude/skills/pmai-*   skill exposure"
echo "   ~/.codex/skills/pmai-*    Codex native skill exposure"
echo "   Kimi Code / OpenCode      optional external Builders (no controller entries installed)"
echo "═══════════════════════════════════════"

# PATH 检测：~/.pmai/bin 不在 PATH 就提示 oneshot（不自动改用户 rc 文件，避免破坏配置）
#
# 双 rc 提示：zsh 用户的 terminal 走 .zshrc，但 Claude Code 内 AI 用 bash 子进程
# 读 .bash_profile/.bashrc，光加 .zshrc 时 chat 里跑 pmai 仍 not found。
PMAI_BIN="$PMAI_HOME/bin"
if [ -d "$PMAI_BIN" ] && ! echo ":$PATH:" | grep -q ":$PMAI_BIN:"; then
  # primary rc：当前 shell 用（terminal 场景）
  case "${SHELL##*/}" in
    zsh)  PRIMARY_RC="$HOME/.zshrc" ;;
    bash) [ -f "$HOME/.bashrc" ] && PRIMARY_RC="$HOME/.bashrc" || PRIMARY_RC="$HOME/.bash_profile" ;;
    *)    PRIMARY_RC="$HOME/.profile" ;;
  esac

  # secondary rc：仅 zsh 用户需要。Claude Code Bash 工具开 bash 子进程，
  # macOS 上 login bash 读 .bash_profile，没有则 .bashrc。
  CC_BASH_RC=""
  if [ "${SHELL##*/}" = "zsh" ]; then
    if [ -f "$HOME/.bash_profile" ]; then
      CC_BASH_RC="$HOME/.bash_profile"
    elif [ -f "$HOME/.bashrc" ]; then
      CC_BASH_RC="$HOME/.bashrc"
    fi
  fi

  PRIMARY_NEED=0
  CC_BASH_NEED=0
  if [ -f "$PRIMARY_RC" ] && grep -q "\.pmai/bin" "$PRIMARY_RC" 2>/dev/null; then
    echo "ℹ️  $PRIMARY_RC 已含 ~/.pmai/bin export — 若当前 shell 没生效，开新窗口或 source 即可"
  else
    PRIMARY_NEED=1
  fi
  if [ -n "$CC_BASH_RC" ]; then
    if [ -f "$CC_BASH_RC" ] && grep -q "\.pmai/bin" "$CC_BASH_RC" 2>/dev/null; then
      : # 已有，沉默跳过（避免 PM 屏幕被两条 ℹ️ 刷屏）
    else
      CC_BASH_NEED=1
    fi
  fi

  if [ "$PRIMARY_NEED" = "1" ] || [ "$CC_BASH_NEED" = "1" ]; then
    echo ""
    echo "📌 加 PATH（pmai 命令立即可用）："
    if [ "$PRIMARY_NEED" = "1" ]; then
      echo "   echo 'export PATH=\"\$HOME/.pmai/bin:\$PATH\"' >> $PRIMARY_RC    # terminal 用"
    fi
    if [ "$CC_BASH_NEED" = "1" ]; then
      echo "   echo 'export PATH=\"\$HOME/.pmai/bin:\$PATH\"' >> $CC_BASH_RC    # Claude Code 内 bash 子进程用"
    fi
    if [ "$PRIMARY_NEED" = "1" ]; then
      if [ "$CC_BASH_NEED" = "1" ]; then
        echo "   source $PRIMARY_RC    # terminal 立即生效；Claude Code 下次启动 session 生效"
      else
        echo "   source $PRIMARY_RC"
      fi
    fi
  fi
fi

echo ""
echo "→ Checking gstack prerequisite..."
check_gstack_readiness

echo ""
echo "Next: cd <any-project> && /pmai-init-project"
