#!/usr/bin/env bash
# pmai-upgrade — Upgrade PMAI framework (default: pull main; --stable: latest tag; --to <ver>: pin)
#
# 升级模型（档 2：VERSION + git tag）：
#   pmai upgrade                          # 全局：cd ~/.pmai && git pull origin main
#   pmai upgrade --stable                 # 全局：跳到最新 git tag
#   pmai upgrade --to v0.1.0              # 全局：锁定指定 tag
#
# 注：旧的 `--local <dir>` 升级模式已移除（连同 install --local）。skill 一律走全局，
#     不再往项目里拷副本，所以也不存在"升级项目副本"这回事。
#
# 安全保证：
#   1. 升级前 dirty 自动 stash（保护 PM 在 ~/.pmai 的本地改动）
#   2. 失败自动回滚到 OLD_HEAD + symlink 按 OLD_HEAD 重建（trap ERR）
#   3. 升完跑 pmai-doctor 自检；不通触发回滚

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../scripts/_lib/global-install-lock.sh"
source "$SCRIPT_DIR/../scripts/_lib/kimi-config-transaction.sh"
ORIGINAL_ARGS=("$@")

load_skill_link_policy() {
  local helper="$1"

  # source 不会删除目标版本未定义的函数。先清空当前进程中的策略函数，避免
  # `--to` 降级时继续沿用新版本策略；旧 helper 没有暴露函数时恢复旧版全公开语义。
  unset -f pmai_skill_is_host_exposed pmai_prune_managed_hidden_skill_links \
    pmai_count_managed_hidden_skill_links pmai_skill_link_is_managed \
    2>/dev/null || true
  if [ -f "$helper" ]; then
    source "$helper" || return 1
  fi
  if ! declare -F pmai_skill_is_host_exposed >/dev/null; then
    pmai_skill_is_host_exposed() { return 0; }
  fi
  return 0
}

load_skill_link_policy "$SCRIPT_DIR/../scripts/_lib/skill-links.sh"

PMAI_HOME="${PMAI_HOME:-$HOME/.pmai}"
PMAI_STATE="${PMAI_STATE:-$HOME/.pmai-state}"
CLAUDE_SKILLS="$HOME/.claude/skills"
CODEX_SKILLS="${CODEX_HOME:-$HOME/.codex}/skills"
CODEX_PROMPTS="${CODEX_HOME:-$HOME/.codex}/prompts"
KIMI_CODE_HOME="${KIMI_CODE_HOME:-$HOME/.kimi-code}"
KIMI_SKILLS="$KIMI_CODE_HOME/skills"
KIMI_CONFIG="$KIMI_CODE_HOME/config.toml"
OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
SKILL_PREFIX="pmai-"
REMOTE="${PMAI_REMOTE:-git@github.com:YYG501/PMAI_Workflow.git}"
DOCTOR_BIN="$PMAI_HOME/bin/pmai-doctor"
DOCTOR_LOG="${PMAI_UPGRADE_DOCTOR_LOG:-}"
DOCTOR_LOG_IS_TEMP=0

prepare_doctor_log() {
  if [ -n "$DOCTOR_LOG" ]; then
    return 0
  fi
  if ! DOCTOR_LOG=$(mktemp "${TMPDIR:-/tmp}/pmai-upgrade-doctor.XXXXXX"); then
    echo "❌ 无法创建 pmai-doctor 临时日志。" >&2
    return 1
  fi
  DOCTOR_LOG_IS_TEMP=1
}

remove_successful_doctor_log() {
  if [ "$DOCTOR_LOG_IS_TEMP" = "1" ] && [ -n "$DOCTOR_LOG" ]; then
    if rm -f -- "$DOCTOR_LOG"; then
      DOCTOR_LOG=""
      DOCTOR_LOG_IS_TEMP=0
    else
      echo "⚠️  doctor 已通过，但临时日志未删除：$DOCTOR_LOG" >&2
    fi
  fi
  return 0
}

# timeout 兜底：stock macOS 无 GNU timeout（仅 Homebrew coreutils 才有）。
# 缺失时优先用 gtimeout，再退化为直接执行（不加超时），避免 `timeout ... || {...}` 误触失败分支中断升级。
if ! command -v timeout >/dev/null 2>&1; then
  if command -v gtimeout >/dev/null 2>&1; then
    timeout() { gtimeout "$@"; }
  else
    timeout() { shift; "$@"; }
  fi
fi

usage() {
  cat <<EOF
Usage:
  pmai upgrade                        # Pull latest main commit (global ~/.pmai/)
  pmai upgrade --stable               # Jump to latest git tag (stable baseline)
  pmai upgrade --to v0.1.0            # Pin to specific tag (rollback / freeze)
  pmai upgrade --no-whats-new         # 升级后跳过 pmai-whats-new 自动展示（skill 接管时用）

Env override:
  PMAI_REMOTE=<git-url>               # Override default github remote
  KIMI_CODE_HOME=<path>               # Override default ~/.kimi-code
  OPENCODE_CONFIG_DIR=<path>          # Override default ~/.config/opencode
EOF
}

MODE="main"
TARGET_TAG=""
NO_WHATS_NEW=0

while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --stable) MODE="stable"; shift ;;
    --to)
      shift
      TARGET_TAG="${1:-}"
      [ -z "$TARGET_TAG" ] && { echo "❌ --to needs <tag>" >&2; usage >&2; exit 2; }
      MODE="to"
      shift
      ;;
    --no-whats-new) NO_WHATS_NEW=1; shift ;;
    "") shift ;;
    *) echo "❌ unknown flag: $1" >&2; usage >&2; exit 2 ;;
  esac
done

pmai_hold_global_install_lock \
  "$SCRIPT_DIR/.." "${BASH_SOURCE[0]}" \
  ${ORIGINAL_ARGS[@]+"${ORIGINAL_ARGS[@]}"}

# ─────────────────────────────────────────────────────────────
# 共享 helper：把 src_skills 装到 dst_skills（symlink）
# ─────────────────────────────────────────────────────────────
rebuild_symlinks() {
  local src_skills="$1"
  local dst_skills="$2"
  local count=0
  local old skill_dir skill_name dst
  # 清旧
  for old in "$dst_skills"/${SKILL_PREFIX}*; do
    if [ -L "$old" ]; then
      rm "$old" || return 1
    fi
  done
  # 重建
  for skill_dir in "$src_skills"/*/; do
    [ -d "$skill_dir" ] || continue
    skill_name=$(basename "$skill_dir")
    case "$skill_name" in
      _internal) continue ;;
      _shared)  dst="$dst_skills/_shared" ;;
      *)
        pmai_skill_is_host_exposed "$skill_name" || continue
        case "$skill_name" in
          pmai-*) dst="$dst_skills/$skill_name" ;;
          *)      dst="$dst_skills/${SKILL_PREFIX}${skill_name}" ;;
        esac
        ;;
    esac
    if [ "$skill_name" = "_shared" ]; then
      pmai_install_shared_link "${skill_dir%/}" "$dst" || return 1
    else
      if [ -e "$dst" ] || [ -L "$dst" ]; then
        rm -rf "$dst" || return 1
      fi
      ln -s "${skill_dir%/}" "$dst" || return 1
    fi
    count=$((count + 1))
  done
  REBUILD_SYMLINK_COUNT="$count"
  return 0
}

remove_managed_codex_prompts() {
  local prompt_dir="$1"
  local count=0
  local old

  REMOVED_PROMPT_COUNT=0
  [ -d "$prompt_dir" ] || return 0
  for old in "$prompt_dir"/${SKILL_PREFIX}*.md; do
    if [ -e "$old" ] || [ -L "$old" ]; then
      if rm -f "$old"; then
        count=$((count + 1))
      else
        echo "⚠️  升级已提交，但 legacy Codex prompt 未删除：$old" >&2
      fi
    fi
  done
  REMOVED_PROMPT_COUNT="$count"
  return 0
}

validate_kimi_config_transaction() {
  local manager_out

  pmai_kimi_config_tx_needs_check || return 0
  if manager_out=$(KIMI_CODE_HOME="$KIMI_CODE_HOME" \
    python3 "$PMAI_HOME/scripts/manage-kimi-hooks.py" \
    check --config "$KIMI_CONFIG" 2>&1); then
    return 0
  fi
  echo "❌ Kimi Code hooks 写入后校验失败：$manager_out" >&2
  return 1
}

record_upgrade_notice_state() {
  local marker="$PMAI_STATE/just-upgraded-from"

  if ! mkdir -p "$PMAI_STATE"; then
    echo "⚠️  升级已完成，但无法创建提示状态目录：$PMAI_STATE" >&2
    return 0
  fi
  if ! printf '%s\n' "$OLD_VER" > "$marker"; then
    echo "⚠️  升级已完成，但无法写入 What's New 标记：$marker" >&2
  fi
  if ! rm -f "$PMAI_STATE/last-update-check"; then
    echo "⚠️  升级已完成，但无法清理更新检查缓存：$PMAI_STATE/last-update-check" >&2
  fi
  if ! rm -f "$PMAI_STATE/update-snoozed"; then
    echo "⚠️  升级已完成，但无法清理更新延后状态：$PMAI_STATE/update-snoozed" >&2
  fi
  return 0
}

# ─────────────────────────────────────────────────────────────
# 回滚状态
# ─────────────────────────────────────────────────────────────
ROLLBACK_DONE=0
UPGRADE_TX_ACTIVE=0
GIT_ROLLBACK_READY=0
STASH_ATTEMPTED=0
STASHED=0
OLD_HEAD=""
OLD_SYMBOLIC_REF=""

global_rollback() {
  local exit_code="${1:-1}"
  local rollback_failed=0
  local git_restored=0
  local actual_head actual_ref

  [ "$ROLLBACK_DONE" = "1" ] && return
  ROLLBACK_DONE=1
  UPGRADE_TX_ACTIVE=0
  trap - ERR HUP INT TERM EXIT
  set +e
  echo "" >&2
  echo "❌ 升级失败，回滚到 ${OLD_HEAD:-原状态}..." >&2
  if [ "$GIT_ROLLBACK_READY" = "1" ]; then
    if [ -n "$OLD_HEAD" ] && [ -d "$PMAI_HOME/.git" ]; then
      if [ -n "$OLD_SYMBOLIC_REF" ]; then
        if (cd "$PMAI_HOME" \
          && git symbolic-ref HEAD "$OLD_SYMBOLIC_REF" \
          && git reset --hard "$OLD_HEAD" >/dev/null 2>&1); then
          git_restored=1
        fi
      else
        if (cd "$PMAI_HOME" \
          && git checkout --detach -q "$OLD_HEAD" \
          && git reset --hard "$OLD_HEAD" >/dev/null 2>&1); then
          git_restored=1
        fi
      fi
      actual_head=$(git -C "$PMAI_HOME" rev-parse HEAD 2>/dev/null || true)
      actual_ref=$(git -C "$PMAI_HOME" symbolic-ref -q HEAD 2>/dev/null || true)
      if [ "$actual_head" != "$OLD_HEAD" ] \
        || { [ -n "$OLD_SYMBOLIC_REF" ] && [ "$actual_ref" != "$OLD_SYMBOLIC_REF" ]; } \
        || { [ -z "$OLD_SYMBOLIC_REF" ] && [ -n "$actual_ref" ]; }; then
        git_restored=0
      fi
    fi
    if [ "$git_restored" != "1" ]; then
      echo "⚠️  Git 未能恢复到原 HEAD：${OLD_HEAD:-未知}（当前仓：$PMAI_HOME）" >&2
      rollback_failed=1
    else
      # reset 后恢复旧版本的暴露策略，不能用升级目标的策略重建旧版入口。
      if ! load_skill_link_policy "$PMAI_HOME/scripts/_lib/skill-links.sh"; then
        echo "⚠️  无法载入回滚版本的 skill 暴露策略。" >&2
        rollback_failed=1
      else
        if ! rebuild_symlinks "$PMAI_HOME/skills" "$CLAUDE_SKILLS" >/dev/null 2>&1; then
          echo "⚠️  Claude Code skill 入口回滚不完整：$CLAUDE_SKILLS" >&2
          rollback_failed=1
        fi
        if ! rebuild_symlinks "$PMAI_HOME/skills" "$CODEX_SKILLS" >/dev/null 2>&1; then
          echo "⚠️  Codex skill 入口回滚不完整：$CODEX_SKILLS" >&2
          rollback_failed=1
        fi
        if ! rebuild_symlinks "$PMAI_HOME/skills" "$KIMI_SKILLS" >/dev/null 2>&1; then
          echo "⚠️  Kimi Code skill 入口回滚不完整：$KIMI_SKILLS" >&2
          rollback_failed=1
        fi
        if [ -f "$PMAI_HOME/scripts/install-opencode-commands.sh" ]; then
          if ! PMAI_HOME="$PMAI_HOME" OPENCODE_CONFIG_DIR="$OPENCODE_CONFIG_DIR" \
            bash "$PMAI_HOME/scripts/install-opencode-commands.sh" --global >/dev/null 2>&1; then
            echo "⚠️  OpenCode command 入口回滚不完整：$OPENCODE_CONFIG_DIR/commands" >&2
            rollback_failed=1
          fi
        else
          echo "⚠️  回滚版本缺少 OpenCode installer：$PMAI_HOME/scripts/install-opencode-commands.sh" >&2
          rollback_failed=1
        fi
      fi
    fi
  elif [ "$STASH_ATTEMPTED" = "1" ]; then
    echo "⚠️  stash 尚未确认完成；为保护未提交改动，本次未执行 reset --hard。" >&2
  fi
  if ! pmai_kimi_config_tx_restore; then
    rollback_failed=1
  fi
  if [ "$rollback_failed" = "1" ]; then
    echo "⚠️  升级回滚未完整；请按以上 HEAD 和路径核对恢复现场。" >&2
  fi
  if [ "$STASHED" = "1" ]; then
    echo "" >&2
    echo "💡 你的本地改动还在 stash 里。恢复：" >&2
    echo "   cd $PMAI_HOME && git stash pop" >&2
  elif [ "$STASH_ATTEMPTED" = "1" ]; then
    echo "💡 stash 可能已经产生；请运行 git -C \"$PMAI_HOME\" stash list 核对。" >&2
  fi
  exit "$exit_code"
}

global_exit_guard() {
  local exit_code="$?"

  if [ "$UPGRADE_TX_ACTIVE" = "1" ]; then
    [ "$exit_code" -ne 0 ] || exit_code=1
    global_rollback "$exit_code"
  fi
}

global_failure_guard() {
  local exit_code="$1"

  if [ "$UPGRADE_TX_ACTIVE" = "1" ]; then
    global_rollback "$exit_code"
  fi
  trap - ERR HUP INT TERM EXIT
  exit "$exit_code"
}

# ─────────────────────────────────────────────────────────────
# 全局模式：A stash + B trap rollback + fetch / checkout + symlink + E doctor
# ─────────────────────────────────────────────────────────────

if [ ! -d "$PMAI_HOME/.git" ]; then
  echo "❌ $PMAI_HOME 不存在或不是 git 仓。先跑 pmai install。" >&2
  exit 1
fi

for dst_skills in "$CLAUDE_SKILLS" "$CODEX_SKILLS" "$KIMI_SKILLS"; do
  pmai_assert_shared_link_available "$PMAI_HOME/skills/_shared" "$dst_skills/_shared"
done

cd "$PMAI_HOME"
OLD_VER=$(cat VERSION 2>/dev/null || echo unknown)
OLD_HEAD=$(git rev-parse HEAD)          # 全 hash，rollback 用
OLD_SYMBOLIC_REF=$(git symbolic-ref -q HEAD 2>/dev/null || true)
OLD_HEAD_SHORT=$(git rev-parse --short HEAD)

# 先确认工作树，再允许任何 reset 型回滚。status 失败或此处收到信号都
# 没有发生写操作，直接退出即可，不能用 reset --hard 猜测恢复。
if ! GIT_STATUS=$(git status --porcelain); then
  echo "❌ 无法确认 ~/.pmai/ 工作树状态，拒绝继续升级。" >&2
  exit 1
fi

UPGRADE_TX_ACTIVE=1
trap 'global_failure_guard 1' ERR
trap 'global_failure_guard 129' HUP
trap 'global_failure_guard 130' INT
trap 'global_failure_guard 143' TERM
trap 'global_exit_guard' EXIT

# A：dirty 自动 stash
if [ -n "$GIT_STATUS" ]; then
  echo "→ ~/.pmai/ 有本地改动，先 stash 一下保护..."
  STASH_MSG="pmai-upgrade auto-stash $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  STASH_ATTEMPTED=1
  if ! git stash push -u -m "$STASH_MSG" >/dev/null; then
    echo "❌ 无法保护 ~/.pmai/ 的本地改动；未执行 reset --hard。" >&2
    global_rollback 1
  fi
  STASHED=1
fi
GIT_ROLLBACK_READY=1

# Git dirty 状态已确认安全后，才开始隔离其它用户级宿主配置。
pmai_kimi_config_tx_snapshot "$KIMI_CONFIG" ".pmai-upgrade-kimi-backup"

# fetch + checkout（保留原逻辑，timeout 兜底）
case "$MODE" in
  main)
    echo "→ Fetching origin/main..."
    timeout 30 git fetch origin main 2>&1 | tail -5 || {
      echo "❌ git fetch 超时（30s）或失败。网络 / SSH 不通？" >&2
      global_rollback
    }
    echo "→ Merging origin/main (ff-only)..."
    git merge --ff-only origin/main 2>&1 | tail -5
    ;;
  stable)
    echo "→ Fetching tags from origin..."
    timeout 60 git fetch origin --tags 2>&1 | tail -5 || {
      echo "❌ git fetch --tags 超时（60s）或失败。" >&2
      global_rollback
    }
    LATEST_TAG=$(git tag -l 'v*' | sort -V | tail -1)
    [ -z "$LATEST_TAG" ] && { echo "❌ 远程没有 v* tag。PM 还没打过 stable。" >&2; global_rollback; }
    echo "→ Checking out latest stable tag: $LATEST_TAG"
    git checkout "$LATEST_TAG"
    ;;
  to)
    echo "→ Fetching tags from origin..."
    timeout 60 git fetch origin --tags 2>&1 | tail -5 || {
      echo "❌ git fetch --tags 超时（60s）或失败。" >&2
      global_rollback
    }
    if ! git rev-parse "refs/tags/$TARGET_TAG" >/dev/null 2>&1; then
      echo "❌ tag $TARGET_TAG 不存在。可用 tag:" >&2
      git tag -l 'v*' | sort -V | tail -10 >&2
      global_rollback
    fi
    echo "→ Checking out tag: $TARGET_TAG"
    git checkout "$TARGET_TAG"
    ;;
esac

NEW_VER=$(cat VERSION 2>/dev/null || echo unknown)
NEW_HEAD=$(git rev-parse --short HEAD)

# 当前进程在 fetch 前已 source 过 helper；升级策略本身可能发生变化，必须重载
# 刚落盘的版本后再重建宿主入口。
load_skill_link_policy "$PMAI_HOME/scripts/_lib/skill-links.sh"

# 重建 symlink
echo "→ Re-syncing skill symlinks to host skill directories"
rebuild_symlinks "$PMAI_HOME/skills" "$CLAUDE_SKILLS"
claude_count="$REBUILD_SYMLINK_COUNT"
rebuild_symlinks "$PMAI_HOME/skills" "$CODEX_SKILLS"
codex_count="$REBUILD_SYMLINK_COUNT"
rebuild_symlinks "$PMAI_HOME/skills" "$KIMI_SKILLS"
kimi_count="$REBUILD_SYMLINK_COUNT"
count=$((claude_count + codex_count + kimi_count))
echo "   $CLAUDE_SKILLS: $claude_count"
echo "   $CODEX_SKILLS: $codex_count"
echo "   $KIMI_SKILLS: $kimi_count"
echo "→ Re-syncing OpenCode slash commands"
PMAI_HOME="$PMAI_HOME" OPENCODE_CONFIG_DIR="$OPENCODE_CONFIG_DIR" \
  bash "$PMAI_HOME/scripts/install-opencode-commands.sh" --global
echo "→ Re-syncing Kimi Code native hooks"
if ! KIMI_CODE_HOME="$KIMI_CODE_HOME" python3 "$PMAI_HOME/scripts/manage-kimi-hooks.py" install --config "$KIMI_CONFIG"; then
  echo "❌ Kimi Code hooks 未能同步，触发完整升级回滚。" >&2
  global_rollback 1
fi

# E：跑升级目标自己的 doctor 自检（FAIL → 回滚；WARN 不触发）。目标版本
# 缺少可执行 doctor 属于不完整升级，不能静默跳过自检。
if [ ! -x "$DOCTOR_BIN" ]; then
  echo "❌ 升级后的 pmai-doctor 缺失或不可执行：$DOCTOR_BIN" >&2
  global_rollback
fi
echo "→ Running pmai-doctor self-check..."
if ! prepare_doctor_log; then
  global_rollback
fi
if ! KIMI_CODE_HOME="$KIMI_CODE_HOME" "$DOCTOR_BIN" >"$DOCTOR_LOG" 2>&1; then
  echo "❌ pmai-doctor 自检失败，触发回滚。日志：$DOCTOR_LOG" >&2
  tail -20 "$DOCTOR_LOG" >&2 || true
  global_rollback
fi
echo "  ✅ doctor passed"
remove_successful_doctor_log

if ! validate_kimi_config_transaction; then
  global_rollback 1
fi
if ! pmai_kimi_config_tx_finalize; then
  echo "❌ Kimi config 无法提交，触发完整升级回滚。" >&2
  global_rollback 1
fi

# 代码、宿主入口和 Kimi config 已全部验证并提交。后续只做 best-effort
# 兼容清理与提示状态，不能把已完成升级误报成事务失败。
UPGRADE_TX_ACTIVE=0
trap - ERR HUP INT TERM EXIT
pmai_kimi_config_tx_cleanup "升级提交后 Kimi config " || true

echo "→ Removing legacy Codex slash prompts"
remove_managed_codex_prompts "$CODEX_PROMPTS"
legacy_prompt_count="$REMOVED_PROMPT_COUNT"
echo "   $CODEX_PROMPTS: $legacy_prompt_count legacy prompt file(s) removed"

echo ""
echo "═══════════════════════════════════════"
if [ "$OLD_HEAD_SHORT" = "$NEW_HEAD" ]; then
  echo "✅ PMAI 已是最新（${NEW_VER} @ ${NEW_HEAD}）"
else
  echo "✅ PMAI 升级：${OLD_VER} (${OLD_HEAD_SHORT}) → ${NEW_VER} (${NEW_HEAD})"
  # 写 JUST_UPGRADED marker + 清 update-check 缓存（下次 skill 跑时显示 What's New）
  record_upgrade_notice_state
fi
echo "   skill: $count symlinks re-synced"
echo "   codex native skills: $codex_count symlinks re-synced"
echo "   kimi native skills: $kimi_count symlinks re-synced"
echo "   legacy codex prompts: $legacy_prompt_count files removed"
echo "   opencode commands: re-synced"
echo "   kimi hooks: re-synced when config.toml exists"
echo "═══════════════════════════════════════"

echo ""
echo "ℹ️  全局升级只更新框架源和宿主 skill。"
echo "   已有消费仓的 Claude Code / Codex 项目 hooks 不会被静默改写。"
echo "   请在各消费仓使用 /pmai-doctor（Codex: \$pmai-doctor；Kimi: /skill:pmai-doctor）检查。"
echo "   确认需要刷新后，在仓内运行："
echo "   bash \"$PMAI_HOME/scripts/install-project-hooks.sh\""

# stash 恢复提示
if [ "$STASHED" = "1" ]; then
  echo ""
  echo "💡 升级前 stash 了 ~/.pmai/ 的本地改动。恢复跑："
  echo "   cd $PMAI_HOME && git stash pop"
fi

# 升级后立即展示 What's New（如有，OLD != NEW 时，--no-whats-new 跳过 — 给 skill 接管用）
if [ "$OLD_HEAD_SHORT" != "$NEW_HEAD" ] && [ "$NO_WHATS_NEW" = "0" ] && [ -x "$(dirname "$0")/pmai-whats-new" ]; then
  echo ""
  "$(dirname "$0")/pmai-whats-new" --from "$OLD_VER" --to "$NEW_VER" || true
fi
