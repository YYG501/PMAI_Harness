#!/usr/bin/env bash
# pmai-whats-new — Show CHANGELOG entries between two versions
#
# 用法：
#   pmai-whats-new                 # 从 ~/.pmai-state/just-upgraded-from 读老版本（若存在则显示并清 marker）
#   pmai-whats-new --from v0.1.0 --to v0.2.0   # 显式指定
#
# 来源：$PMAI_HOME/CHANGELOG.md 的「未发布」段 + 目标版本段

set -euo pipefail

PMAI_HOME="${PMAI_HOME:-$HOME/.pmai}"
PMAI_STATE="${PMAI_STATE:-$HOME/.pmai-state}"
MARKER="$PMAI_STATE/just-upgraded-from"
CHANGELOG="$PMAI_HOME/CHANGELOG.md"

FROM=""
TO=""
SILENT_IF_NO_MARKER=0
MAX_LINES=40
FULL=0

while [ $# -gt 0 ]; do
  case "$1" in
    --from) FROM="${2:?--from needs version}"; shift 2 ;;
    --to)   TO="${2:?--to needs version}"; shift 2 ;;
    --max-lines) MAX_LINES="${2:?--max-lines needs number}"; shift 2 ;;
    --full) FULL=1; shift ;;
    --silent-if-no-marker) SILENT_IF_NO_MARKER=1; shift ;;
    --help|-h)
      cat <<EOF
Usage: pmai-whats-new [--from VER] [--to VER] [--max-lines N] [--full] [--silent-if-no-marker]

  Show CHANGELOG entries since last upgrade.
  Default: read ~/.pmai-state/just-upgraded-from marker (clears after read).
  Default output is capped for readability; use --full to print the full unreleased section.
EOF
      exit 0 ;;
    *) echo "❌ unknown flag: $1" >&2; exit 2 ;;
  esac
done

if ! [[ "$MAX_LINES" =~ ^[0-9]+$ ]] || [ "$MAX_LINES" -lt 1 ]; then
  echo "❌ --max-lines 必须是正整数: $MAX_LINES" >&2
  exit 2
fi

if [ "$FULL" = "1" ]; then
  MAX_LINES=999999
fi

display_version() {
  local version="$1"
  case "$version" in
    current|unknown) echo "$version" ;;
    v*) echo "$version" ;;
    *) echo "v$version" ;;
  esac
}

# 无显式 --from 时从 marker 读
if [ -z "$FROM" ]; then
  if [ -f "$MARKER" ]; then
    FROM=$(cat "$MARKER" 2>/dev/null || true)
  fi
  if [ -z "$FROM" ]; then
    [ "$SILENT_IF_NO_MARKER" = "1" ] && exit 0
    echo "（无 just-upgraded-from marker；用 --from VER 显式指定）" >&2
    exit 0
  fi
fi

[ -z "$TO" ] && TO=$(cat "$PMAI_HOME/VERSION" 2>/dev/null || echo "current")

if [ ! -f "$CHANGELOG" ]; then
  echo "（CHANGELOG.md 不在 ${PMAI_HOME}，跳过）" >&2
  exit 0
fi

# 显示「未发布」段（永远显示，因为正在迭代到最新）
# 加上自从 $FROM 到 $TO 之间的所有 ### 日期 段
echo "════════════════════════════════════════════════════════════"
echo "  PMAI $(display_version "$TO") — upgraded from $(display_version "$FROM")"
echo "════════════════════════════════════════════════════════════"
echo ""

# 提取「未发布」段（从「## 未发布」到下一个「## 」之间）；NR 限制避免 SIGPIPE
echo "📝 未发布段："
awk -v max_lines="$MAX_LINES" '/^## 未发布/{flag=1; printed=0; next} /^## /{flag=0} flag && printed<max_lines {print; printed++}' "$CHANGELOG"
if [ "$FULL" != "1" ]; then
  echo "（默认最多显示 ${MAX_LINES} 行；完整内容用 --full 或直接看 CHANGELOG.md）"
fi
echo ""

# stable 发布会把未发布内容归档到 `## vX.Y.Z`，升级时直接展示目标版本正文。
VERSIONED_SECTION=""
case "$TO" in
  current|unknown) ;;
  *)
    TO_VERSION="${TO#v}"
    VERSIONED_SECTION=$(awk -v target="v$TO_VERSION" '
      $0 ~ "^## " target "( |$)" {found=1; print; next}
      found && /^## / {exit}
      found {print}
    ' "$CHANGELOG")
    ;;
esac
if [ -n "${VERSIONED_SECTION//[[:space:]]/}" ]; then
  echo "🏷️  已发布版本段："
  echo "$VERSIONED_SECTION"
fi

# 读完清 marker（无论 --from 显式还是 marker 读出，反正 What's New 已展示）
if [ -f "$MARKER" ]; then
  rm -f "$MARKER"
fi

echo ""
echo "════════════════════════════════════════════════════════════"
echo "升级内容已展示。需要检查框架和当前消费仓时，运行 pmai doctor --check。"
