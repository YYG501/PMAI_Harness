#!/usr/bin/env bash
# pmai-status — Show current PMAI install state
#
# 显示：
#   - 全局安装状态（~/.pmai/ 装了没）
#   - 当前 VERSION + 远程 main HEAD diff（多少 commit 落后）
#   - skill / slash command 暴露清单
#   - update-check 提示

set -uo pipefail

PMAI_HOME="${PMAI_HOME:-$HOME/.pmai}"
CLAUDE_SKILLS="$HOME/.claude/skills"
CODEX_SKILLS="${CODEX_HOME:-$HOME/.codex}/skills"
KIMI_CODE_HOME="${KIMI_CODE_HOME:-$HOME/.kimi-code}"
KIMI_SKILLS="$KIMI_CODE_HOME/skills"
KIMI_CONFIG="$KIMI_CODE_HOME/config.toml"
OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
OPENCODE_COMMANDS="$OPENCODE_CONFIG_DIR/commands"
SKILL_PREFIX="pmai-"
BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
CLI_ROOT="$(cd "$BIN_DIR/.." && pwd)"
source "$CLI_ROOT/scripts/_lib/skill-links.sh"

usage() {
  cat <<EOF
Usage:
  pmai status

Shows global PMAI install state:
  - source location, version, branch, remote
  - skill exposure count and drift against current ~/.pmai/skills for Claude, Codex, and Kimi Code
  - Kimi Code CLI readiness and PMAI-managed native hooks
  - OpenCode slash command count and drift against current ~/.pmai/skills
  - local install note
EOF
}

case "${1:-}" in
  --help|-h|help) usage; exit 0 ;;
  "") ;;
  *) echo "❌ unknown flag: $1" >&2; usage >&2; exit 2 ;;
esac

expected_exposed_skill_names() {
  local skill_dir skill_name

  [ -d "$PMAI_HOME/skills" ] || return 0
  for skill_dir in "$PMAI_HOME"/skills/*/; do
    [ -d "$skill_dir" ] || continue
    skill_name=$(basename "$skill_dir")
    case "$skill_name" in
      _internal) ;;
      _shared) ;;
      *)
        pmai_skill_is_host_exposed "$skill_name" || continue
        case "$skill_name" in
          pmai-*) echo "$skill_name" ;;
          *) echo "${SKILL_PREFIX}${skill_name}" ;;
        esac
        ;;
    esac
  done | sort -u
}

actual_exposed_skill_names() {
  local exposure_dir="$1"
  local s

  for s in "$exposure_dir"/${SKILL_PREFIX}*; do
    [ -e "$s" ] || [ -L "$s" ] || continue
    basename "$s"
  done | sort -u
}

expected_opencode_command_names() {
  expected_exposed_skill_names | sed 's/$/.md/' | sort -u
}

actual_opencode_command_names() {
  local command_dir="$1"
  local s

  for s in "$command_dir"/${SKILL_PREFIX}*.md; do
    [ -e "$s" ] || continue
    basename "$s"
  done | sort -u
}

count_opencode_commands() {
  local command_dir="$1"
  local s count

  count=0
  for s in "$command_dir"/${SKILL_PREFIX}*.md; do
    [ -e "$s" ] || continue
    count=$((count + 1))
  done
  echo "$count"
}

report_skill_exposure() {
  local label="$1"
  local exposure_dir="$2"
  local display_path="$3"
  local symlink_count shared_link stale_exposed missing_exposed

  symlink_count=$(ls -d "$exposure_dir"/${SKILL_PREFIX}* 2>/dev/null | wc -l | tr -d ' ')
  shared_link="❌ no"
  if [ -L "$exposure_dir/_shared" ]; then shared_link="✅ yes"; fi

  # 没装时 symlink 都是悬空（指向不存在的 ~/.pmai/），明示而不是假装存在
  if [ "$INSTALLED" = "0" ] && [ "$symlink_count" -gt 0 ]; then
    echo "  $label (${display_path}/${SKILL_PREFIX}*):  $symlink_count symlinks ⚠️  悬空（指向不存在的 ${PMAI_HOME}；pmai install 后才生效）"
    echo "  $label _shared linked:                    $shared_link"
  elif [ "$INSTALLED" = "0" ] && [ "$symlink_count" = "0" ]; then
    echo "  $label (${display_path}/${SKILL_PREFIX}*):  $symlink_count symlinks"
    echo "  $label _shared linked:                    $shared_link"
  else
    echo "  $label (${display_path}/${SKILL_PREFIX}*):  $symlink_count symlinks"
    echo "  $label _shared linked:                    $shared_link"
    stale_exposed=$(comm -23 <(actual_exposed_skill_names "$exposure_dir") <(expected_exposed_skill_names) || true)
    missing_exposed=$(comm -13 <(actual_exposed_skill_names "$exposure_dir") <(expected_exposed_skill_names) || true)
    if [ -z "$stale_exposed" ] && [ -z "$missing_exposed" ]; then
      echo "  $label drift:                             ✅ matches current skills"
    else
      echo "  $label drift:                             ⚠️  stale/missing entries (run: pmai upgrade)"
      [ -n "$stale_exposed" ] && echo "    stale:  $(echo "$stale_exposed" | tr '\n' ' ')"
      [ -n "$missing_exposed" ] && echo "    missing: $(echo "$missing_exposed" | tr '\n' ' ')"
    fi
  fi

  # 装好时才列具体 skill；没装时悬空名单意义不大
  if [ "$INSTALLED" = "1" ] && [ "$symlink_count" -gt 0 ]; then
    echo ""
    echo "  $label skills exposed (pmai-* prefix):"
    ls -d "$exposure_dir"/${SKILL_PREFIX}* 2>/dev/null | xargs -n 1 basename | sed 's/^/    /'
  fi
}

report_opencode_command_exposure() {
  local command_dir="$1"
  local display_path="$2"
  local command_count stale_commands missing_commands opencode_bin

  opencode_bin=$(command -v opencode 2>/dev/null || true)
  if [ -n "$opencode_bin" ]; then
    echo "  OpenCode CLI:                              ✅ $opencode_bin"
  else
    echo "  OpenCode CLI:                              ⚠️  not found (commands can still be installed)"
  fi

  command_count=$(count_opencode_commands "$command_dir")

  if [ "$INSTALLED" = "0" ]; then
    echo "  OpenCode (${display_path}/${SKILL_PREFIX}*.md):  $command_count command files"
    return
  fi

  echo "  OpenCode (${display_path}/${SKILL_PREFIX}*.md):  $command_count command files"
  stale_commands=$(comm -23 <(actual_opencode_command_names "$command_dir") <(expected_opencode_command_names) || true)
  missing_commands=$(comm -13 <(actual_opencode_command_names "$command_dir") <(expected_opencode_command_names) || true)
  if [ -z "$stale_commands" ] && [ -z "$missing_commands" ]; then
    echo "  OpenCode command drift:                    ✅ matches current skills"
  else
    echo "  OpenCode command drift:                    ⚠️  stale/missing entries (run: pmai upgrade)"
    [ -n "$stale_commands" ] && echo "    stale:  $(echo "$stale_commands" | tr '\n' ' ')"
    [ -n "$missing_commands" ] && echo "    missing: $(echo "$missing_commands" | tr '\n' ' ')"
  fi
}

report_kimi_host() {
  local kimi_bin manager_rc

  kimi_bin=$(command -v kimi 2>/dev/null || true)
  if [ -z "$kimi_bin" ] && [ -x "$KIMI_CODE_HOME/bin/kimi" ]; then
    kimi_bin="$KIMI_CODE_HOME/bin/kimi"
  fi
  if [ -n "$kimi_bin" ]; then
    echo "  Kimi Code CLI:                             ✅ $kimi_bin"
  else
    echo "  Kimi Code CLI:                             ⚠️  not found (skills can still be installed)"
  fi
  echo "  Kimi native command:                       /skill:pmai-<name>"

  if [ ! -f "$KIMI_CONFIG" ]; then
    echo "  Kimi PMAI hooks:                           ⚠️  config.toml not found"
    return
  fi
  if [ ! -f "$PMAI_HOME/scripts/manage-kimi-hooks.py" ]; then
    echo "  Kimi PMAI hooks:                           ⚠️  manager missing"
    return
  fi
  KIMI_CODE_HOME="$KIMI_CODE_HOME" python3 "$PMAI_HOME/scripts/manage-kimi-hooks.py" check --config "$KIMI_CONFIG" >/dev/null 2>&1
  manager_rc=$?
  if [ "$manager_rc" = "0" ]; then
    echo "  Kimi PMAI hooks:                           ✅ matches current framework"
  else
    echo "  Kimi PMAI hooks:                           ⚠️  missing/drifted (run: pmai doctor)"
  fi
}

echo "════════════════════════════════════════════════════════════"
echo "  PMAI Status"
echo "════════════════════════════════════════════════════════════"
echo "CLI source:     $CLI_ROOT"
echo "Status target:  $PMAI_HOME"
if [ "$CLI_ROOT" != "$PMAI_HOME" ] && [ -x "$PMAI_HOME/bin/pmai" ]; then
  echo "Note: repo-local CLI is inspecting the installed PMAI_HOME."
  echo "      To inspect the installed user-facing CLI, run: $PMAI_HOME/bin/pmai status"
fi
echo ""

if [ -d "$PMAI_HOME/.git" ]; then
  cd "$PMAI_HOME"
  VER=$(cat VERSION 2>/dev/null || echo unknown)
  HEAD=$(git rev-parse --short HEAD 2>/dev/null || echo "?")
  BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
  REMOTE=$(git remote get-url origin 2>/dev/null || echo none)

  echo "Global install:   ✅ installed"
  echo "  Location:       $PMAI_HOME"
  echo "  Version:        v$VER"
  echo "  Branch:         $BRANCH @ $HEAD"
  echo "  Remote:         $REMOTE"

  # 跟远程比 commit 差
  BEHIND=$(git rev-list --count "HEAD..origin/main" 2>/dev/null || echo "?")
  AHEAD=$(git rev-list --count "origin/main..HEAD" 2>/dev/null || echo "?")
  if [ "$BEHIND" != "?" ] && [ "$BEHIND" != "0" ]; then
    echo "  Behind main:    $BEHIND commits (run: pmai upgrade)"
  fi
  if [ "$AHEAD" != "?" ] && [ "$AHEAD" != "0" ]; then
    echo "  Ahead of main:  $AHEAD commits (uncommon — local edits?)"
  fi

  # 工作树脏检查
  if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
    echo "  ⚠️  working tree dirty — 影响所有依赖 ~/.pmai/ 的消费仓"
  fi

  # update-check
  if [ -x "$(dirname "$0")/pmai-update-check" ]; then
    UPD=$("$(dirname "$0")/pmai-update-check" 2>/dev/null)
    [ -n "$UPD" ] && echo "  📦 $UPD"
  fi
  INSTALLED=1
else
  echo "Global install:   ❌ not installed (run: pmai install)"
  INSTALLED=0
fi

echo ""
echo "─── Skill exposure ───"
report_skill_exposure "Claude Code" "$CLAUDE_SKILLS" "~/.claude/skills"
echo ""
report_skill_exposure "Codex" "$CODEX_SKILLS" "~/.codex/skills"
echo ""
report_skill_exposure "Kimi Code" "$KIMI_SKILLS" "\$KIMI_CODE_HOME/skills"
echo ""
echo "─── Kimi Code native host ───"
report_kimi_host
echo ""
echo "─── OpenCode slash commands ───"
report_opencode_command_exposure "$OPENCODE_COMMANDS" "~/.config/opencode/commands"

echo "════════════════════════════════════════════════════════════"
