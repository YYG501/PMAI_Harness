#!/usr/bin/env bash
# pmai-status — Compatibility alias for the read-only doctor contract.

set -euo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
DOCTOR="$BIN_DIR/pmai-doctor"

usage() {
  cat <<'EOF'
Usage:
  pmai status [--json]

Compatibility alias for:
  pmai doctor --check [--json]

`pmai status` is deprecated. In chat, use /pmai-status for product progress and
/pmai-doctor for framework and consumer-repository health.
EOF
}

JSON_ARG=""
while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h|help)
      usage
      exit 0
      ;;
    --json)
      if [ -n "$JSON_ARG" ]; then
        echo "❌ duplicate flag: --json" >&2
        exit 2
      fi
      JSON_ARG="--json"
      ;;
    *)
      echo "❌ unknown flag: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [ ! -x "$DOCTOR" ]; then
  echo "❌ pmai-doctor 不存在或不可执行：$DOCTOR" >&2
  exit 1
fi

echo "⚠️  pmai status 已并入 pmai doctor --check；当前按兼容入口执行。" >&2
exec "$DOCTOR" --check ${JSON_ARG:+"$JSON_ARG"}
