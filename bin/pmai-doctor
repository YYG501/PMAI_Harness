#!/usr/bin/env bash
# pmai-doctor — Integrity self-check (covers §8 critical gaps from design doc)
#
# Checks:
#   1. ~/.pmai/ exists + is a git repo
#   2. VERSION file is valid semver
#   3. All expected skills present (~/.pmai/skills/*)
#   4. All symlinks under host skill dirs resolve (no dangling)
#   5. OpenCode slash commands installed and aligned
#   6. ~/.pmai/ working tree clean (or warn if dirty — affects consumers)
#   7. Remote reachable (short network check, non-fatal)
#   8. Claude Code Bash 工具子进程 PATH 能调到 pmai（zsh 用户常踩盲点）
#   9. gstack readiness（可选浏览器/设计适配器，缺失时 warning）
#   10. gstack browser/design diagnostics（mockup 的可选外部能力）

set -uo pipefail

PMAI_HOME="${PMAI_HOME:-$HOME/.pmai}"
CLAUDE_SKILLS="$HOME/.claude/skills"
CODEX_SKILLS="${CODEX_HOME:-$HOME/.codex}/skills"
CODEX_PROMPTS="${CODEX_HOME:-$HOME/.codex}/prompts"
OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
OPENCODE_COMMANDS="$OPENCODE_CONFIG_DIR/commands"
SKILL_PREFIX="pmai-"
BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
CLI_ROOT="$(cd "$BIN_DIR/.." && pwd)"

EXIT_CODE=0
PASS_COUNT=0
WARN_COUNT=0
FAIL_COUNT=0
BROWSER_SMOKE=0

usage() {
  cat <<EOF
Usage:
  pmai doctor [--browser-smoke]

Checks global PMAI install integrity:
  - ~/.pmai source, VERSION, expected skills
  - ~/.claude/skills/pmai-* and ~/.codex/skills/pmai-* exposure drift and dangling symlinks
  - ~/.codex/prompts/pmai-*.md Codex CLI slash prompt exposure
  - ~/.config/opencode/commands/pmai-*.md OpenCode slash command exposure
  - working tree, remote reachability, Claude Code bash PATH
  - optional gstack/browser readiness
  - passive gstack browser/design diagnostics for /pmai-mockup
  - with --browser-smoke: actively launch gstack browse and fail if unusable
EOF
}

ok()   { echo "  ✅ $*"; PASS_COUNT=$((PASS_COUNT + 1)); }
warn() { echo "  ⚠️  $*"; WARN_COUNT=$((WARN_COUNT + 1)); }
fail() { echo "  ❌ $*"; FAIL_COUNT=$((FAIL_COUNT + 1)); EXIT_CODE=1; }

while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h|help) usage; exit 0 ;;
    --browser-smoke) BROWSER_SMOKE=1 ;;
    *) echo "❌ unknown flag: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

echo "════════════════════════════════════════════════════════════"
echo "  PMAI Doctor — integrity self-check"
echo "════════════════════════════════════════════════════════════"
echo "  CLI source:   $CLI_ROOT"
echo "  Audit target: $PMAI_HOME"
if [ "$CLI_ROOT" != "$PMAI_HOME" ] && [ -x "$PMAI_HOME/bin/pmai" ]; then
  echo "  Note: repo-local CLI is validating the installed PMAI_HOME."
  echo "        To test the installed user-facing CLI, run: $PMAI_HOME/bin/pmai doctor"
fi

# 1. ~/.pmai/ exists + is git repo
echo ""
echo "─── 1. Framework source ───"
if [ ! -d "$PMAI_HOME" ]; then
  fail "$PMAI_HOME 不存在（未安装；运行 pmai install）"
  echo ""
  echo "════════════════════════════════════════════════════════════"
  echo "Result: ❌ FAIL ($FAIL_COUNT) / ⚠️  $WARN_COUNT / ✅ $PASS_COUNT"
  exit 1
fi
ok "$PMAI_HOME exists"

if [ ! -d "$PMAI_HOME/.git" ]; then
  fail "$PMAI_HOME 不是 git 仓（损坏 / 半完整；建议重装：pmai uninstall && pmai install）"
else
  ok "$PMAI_HOME is a git repo"
fi

# 2. VERSION 文件
echo ""
echo "─── 2. VERSION file ───"
if [ ! -f "$PMAI_HOME/VERSION" ]; then
  fail "VERSION 文件缺失"
else
  VER=$(cat "$PMAI_HOME/VERSION")
  if [[ "$VER" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    ok "VERSION = $VER (valid semver)"
  else
    warn "VERSION = $VER 不是标准 semver (X.Y.Z)"
  fi
fi

# 3. Skills 全勤
echo ""
echo "─── 3. Skills in ~/.pmai/skills/ ───"
# 期望全勤的公开 skill —— 必须与 skills/ 目录（除 _shared / _internal）完全一致。
# ⚠️ 加 / 删 skill 时必须同步本清单 —— 否则 pmai upgrade 的 doctor 自检会误判「缺 skill」触发回滚
#    （reshape 删 req-analysis、加 build/build-close/design/mockup/status 时漏改本清单的教训）。
#    tests/test-doctor-skills.sh 对本清单与 skills/ 目录做全等校验，漏同步会在 run-all 红掉。
EXPECTED_SKILLS=(
  # 活跃集（reshape 后 PM 日常入口）
  init-project design mockup build build-close publish-to-lark lark-sync status
  # 按需主动调（项目方向 / 照站对齐）
  direction mirror-site
  # 按需辅助：小改 / 轻记录 / 放弃 build / 功能型规格文档 / 介绍型文档 / 说人话磨文 / 讨论对焦
  quick-fix record build-cancel spec-writing doc-writing humanize meta
  # 框架自身维护
  pmai-upgrade skill-improve
)

expected_exposed_skill_names() {
  local sk
  for sk in "${EXPECTED_SKILLS[@]}"; do
    case "$sk" in
      pmai-*) echo "$sk" ;;
      *) echo "${SKILL_PREFIX}${sk}" ;;
    esac
  done | sort -u
}

actual_exposed_skill_names() {
  local exposure_dir="$1"
  local s
  for s in "$exposure_dir"/${SKILL_PREFIX}*; do
    [ -e "$s" ] || [ -L "$s" ] || continue
    basename "$s"
  done | sort -u
}

expected_codex_prompt_names() {
  expected_exposed_skill_names | sed 's/$/.md/' | sort -u
}

actual_codex_prompt_names() {
  local prompt_dir="$1"
  local s
  for s in "$prompt_dir"/${SKILL_PREFIX}*.md; do
    [ -e "$s" ] || continue
    basename "$s"
  done | sort -u
}

count_codex_prompts() {
  local prompt_dir="$1"
  local s count

  count=0
  for s in "$prompt_dir"/${SKILL_PREFIX}*.md; do
    [ -e "$s" ] || continue
    count=$((count + 1))
  done
  echo "$count"
}

actual_opencode_command_names() {
  local command_dir="$1"
  local s
  for s in "$command_dir"/${SKILL_PREFIX}*.md; do
    [ -e "$s" ] || continue
    basename "$s"
  done | sort -u
}

count_opencode_commands() {
  local command_dir="$1"
  local s count

  count=0
  for s in "$command_dir"/${SKILL_PREFIX}*.md; do
    [ -e "$s" ] || continue
    count=$((count + 1))
  done
  echo "$count"
}

exposed_name_for_skill() {
  case "$1" in
    pmai-*) echo "$1" ;;
    *) echo "${SKILL_PREFIX}$1" ;;
  esac
}

write_codex_prompt() {
  local prompt_dir="$1"
  local skill_name="$2"
  local exposed_name="$3"
  local dst="$prompt_dir/${exposed_name}.md"

  cat > "$dst" <<EOF
---
description: Run PMAI /${exposed_name} workflow
argument-hint: command arguments
---

执行 PMAI /${exposed_name}。

输入：本 slash command 后面的文字就是 /${exposed_name} 的参数。

必须按以下步骤执行：

1. 定位 PMAI_HOME：优先使用环境变量 \`PMAI_HOME\`；没有则使用 \`~/.pmai\`。
2. 如果当前项目根目录有 \`AGENTS.md\`，先遵守其中的 PMAI Host Mapping 和 Startup 规则。
3. 如果当前命令不是 \`/pmai-init-project\` 或 \`/pmai-upgrade\`，先运行 \`bash -lc 'source "\${PMAI_HOME:-\$HOME/.pmai}/scripts/skill-preamble.sh"'\`。如果输出 \`PMAI_PROJECT_INITIALIZED: 0\`，停止当前 skill，只引导 PM 先发 \`/pmai-init-project\`。 \`/pmai-humanize\` 仅在处理粘贴文本或仓外文件、且不写 PMAI 项目产物时可继续；要读取或改写仓内文档时同样停止。
4. 完整读取 \`\$PMAI_HOME/skills/${skill_name}/SKILL.md\`。
5. 如果该 \`SKILL.md\` 引用 \`_shared/...\`、\`references/...\`、\`templates/...\` 或脚本，按文件路径继续读取必要内容。
6. 严格按 skill workflow 执行；不要只凭本 prompt 或记忆模拟。
7. 默认用中文和 PM 沟通。

如果 skill 文件不存在，先说明 PMAI 未安装或安装损坏，并建议运行 \`pmai doctor\`。
EOF
}

repair_codex_prompts() {
  local prompt_dir="$1"
  local skill_dir skill_name exposed_name count

  [ -d "$PMAI_HOME/skills" ] || return 1
  mkdir -p "$prompt_dir" || return 1

  count=0
  for skill_dir in "$PMAI_HOME"/skills/*/; do
    [ -d "$skill_dir" ] || continue
    skill_name=$(basename "$skill_dir")
    case "$skill_name" in
      _internal|_shared) continue ;;
    esac
    exposed_name=$(exposed_name_for_skill "$skill_name")
    write_codex_prompt "$prompt_dir" "$skill_name" "$exposed_name" || return 1
    count=$((count + 1))
  done
  ok "Codex CLI slash prompts repaired ($count file(s) written)"
  return 0
}

repair_opencode_commands() {
  if [ ! -f "$PMAI_HOME/scripts/install-opencode-commands.sh" ]; then
    return 1
  fi

  if PMAI_HOME="$PMAI_HOME" OPENCODE_CONFIG_DIR="$OPENCODE_CONFIG_DIR" \
    bash "$PMAI_HOME/scripts/install-opencode-commands.sh" --global >/dev/null 2>&1; then
    ok "OpenCode slash commands repaired"
    return 0
  fi

  return 1
}

repair_empty_exposure_dir() {
  local label="$1"
  local exposure_dir="$2"
  local skill_dir skill_name dst count

  [ -d "$PMAI_HOME/skills" ] || return 1
  mkdir -p "$exposure_dir" || return 1

  count=0
  for skill_dir in "$PMAI_HOME"/skills/*/; do
    [ -d "$skill_dir" ] || continue
    skill_name=$(basename "$skill_dir")
    case "$skill_name" in
      _internal) continue ;;
      _shared)  dst="$exposure_dir/_shared" ;;
      pmai-*)   dst="$exposure_dir/$skill_name" ;;
      *)        dst="$exposure_dir/${SKILL_PREFIX}${skill_name}" ;;
    esac

    if [ -e "$dst" ] && [ ! -L "$dst" ]; then
      warn "$label exposure repair skipped non-symlink path: $dst"
      return 1
    fi
    rm -f "$dst" 2>/dev/null || return 1
    ln -s "${skill_dir%/}" "$dst" || return 1
    count=$((count + 1))
  done

  ok "$label initial skill exposure repaired ($count symlink(s) created)"
  return 0
}

check_skill_exposure_dir() {
  local label="$1"
  local exposure_dir="$2"
  local display_path="$3"
  local s count stale_exposed missing_exposed
  local dangling=()

  echo ""
  echo "─── 4. Skill symlinks ($label: ${display_path}/${SKILL_PREFIX}*) ───"
  count=0
  for s in "$exposure_dir"/${SKILL_PREFIX}* "$exposure_dir/_shared"; do
    [ -e "$s" ] || [ -L "$s" ] || continue
    if [ -L "$s" ]; then
      if [ ! -e "$s" ]; then
        dangling+=("$s")
      fi
      count=$((count + 1))
    fi
  done
  if [ "$count" = "0" ]; then
    if repair_empty_exposure_dir "$label" "$exposure_dir"; then
      dangling=()
      count=0
      for s in "$exposure_dir"/${SKILL_PREFIX}* "$exposure_dir/_shared"; do
        [ -e "$s" ] || [ -L "$s" ] || continue
        if [ -L "$s" ]; then
          if [ ! -e "$s" ]; then
            dangling+=("$s")
          fi
          count=$((count + 1))
        fi
      done
    fi
  fi
  if [ "$count" = "0" ]; then
    fail "No skill symlinks found (${display_path}/${SKILL_PREFIX}*). 跑 pmai install 或 pmai upgrade。"
  elif [ ${#dangling[@]} -gt 0 ]; then
    fail "Dangling symlinks: ${dangling[*]} (~/.pmai/ 可能被损坏；建议 pmai uninstall && pmai install)"
  else
    ok "$count skill symlink(s) all resolve"
  fi

  if [ "$count" != "0" ]; then
    stale_exposed=$(comm -23 <(actual_exposed_skill_names "$exposure_dir") <(expected_exposed_skill_names) || true)
    missing_exposed=$(comm -13 <(actual_exposed_skill_names "$exposure_dir") <(expected_exposed_skill_names) || true)
    if [ -n "$stale_exposed" ]; then
      fail "$label stale exposed skill symlink(s): $(echo "$stale_exposed" | tr '\n' ' ') — run pmai upgrade to resync"
    fi
    if [ -n "$missing_exposed" ]; then
      fail "$label missing exposed skill symlink(s): $(echo "$missing_exposed" | tr '\n' ' ') — run pmai upgrade to resync"
    fi
    if [ -z "$stale_exposed" ] && [ -z "$missing_exposed" ] && [ ${#dangling[@]} -eq 0 ]; then
      ok "$label $(expected_exposed_skill_names | wc -l | tr -d ' ') exposed skill name(s) match current skills"
    fi
  fi
}

check_codex_prompt_dir() {
  local prompt_dir="$1"
  local display_path="$2"
  local count stale_prompts missing_prompts

  echo ""
  echo "─── 4b. Codex CLI slash prompts (${display_path}/${SKILL_PREFIX}*.md) ───"
  count=$(count_codex_prompts "$prompt_dir")

  stale_prompts=$(comm -23 <(actual_codex_prompt_names "$prompt_dir") <(expected_codex_prompt_names) || true)
  missing_prompts=$(comm -13 <(actual_codex_prompt_names "$prompt_dir") <(expected_codex_prompt_names) || true)

  if [ "$count" = "0" ] || [ -n "$missing_prompts" ]; then
    if repair_codex_prompts "$prompt_dir"; then
      count=$(count_codex_prompts "$prompt_dir")
      stale_prompts=$(comm -23 <(actual_codex_prompt_names "$prompt_dir") <(expected_codex_prompt_names) || true)
      missing_prompts=$(comm -13 <(actual_codex_prompt_names "$prompt_dir") <(expected_codex_prompt_names) || true)
    fi
  fi

  if [ "$count" = "0" ]; then
    fail "No Codex CLI slash prompts found (${display_path}/${SKILL_PREFIX}*.md). 跑 pmai install 或 pmai upgrade。"
  elif [ -n "$stale_prompts" ]; then
    fail "Codex stale slash prompt file(s): $(echo "$stale_prompts" | tr '\n' ' ') — run pmai upgrade to resync"
  elif [ -n "$missing_prompts" ]; then
    fail "Codex missing slash prompt file(s): $(echo "$missing_prompts" | tr '\n' ' ') — run pmai upgrade to resync"
  else
    ok "Codex $(expected_codex_prompt_names | wc -l | tr -d ' ') slash prompt file(s) match current skills"
  fi
}

check_opencode_command_dir() {
  local command_dir="$1"
  local display_path="$2"
  local count stale_commands missing_commands

  echo ""
  echo "─── 4c. OpenCode slash commands (${display_path}/${SKILL_PREFIX}*.md) ───"
  count=$(count_opencode_commands "$command_dir")

  stale_commands=$(comm -23 <(actual_opencode_command_names "$command_dir") <(expected_codex_prompt_names) || true)
  missing_commands=$(comm -13 <(actual_opencode_command_names "$command_dir") <(expected_codex_prompt_names) || true)

  if [ "$count" = "0" ] || [ -n "$missing_commands" ]; then
    if repair_opencode_commands; then
      count=$(count_opencode_commands "$command_dir")
      stale_commands=$(comm -23 <(actual_opencode_command_names "$command_dir") <(expected_codex_prompt_names) || true)
      missing_commands=$(comm -13 <(actual_opencode_command_names "$command_dir") <(expected_codex_prompt_names) || true)
    fi
  fi

  if [ "$count" = "0" ]; then
    fail "No OpenCode slash commands found (${display_path}/${SKILL_PREFIX}*.md). 跑 pmai install 或 pmai upgrade。"
  elif [ -n "$stale_commands" ]; then
    fail "OpenCode stale slash command file(s): $(echo "$stale_commands" | tr '\n' ' ') — run pmai upgrade to resync"
  elif [ -n "$missing_commands" ]; then
    fail "OpenCode missing slash command file(s): $(echo "$missing_commands" | tr '\n' ' ') — run pmai upgrade to resync"
  else
    ok "OpenCode $(expected_codex_prompt_names | wc -l | tr -d ' ') slash command file(s) match current skills"
  fi
}

check_opencode_cli() {
  local opencode_bin

  echo ""
  echo "─── 4d. OpenCode CLI ───"
  opencode_bin=$(command -v opencode 2>/dev/null || true)
  if [ -n "$opencode_bin" ]; then
    ok "opencode command found: $opencode_bin"
  else
    warn "opencode command not found — OpenCode 主控入口已可安装，但本机还不能直接运行 OpenCode CLI"
  fi
}

MISSING=()
for sk in "${EXPECTED_SKILLS[@]}"; do
  if [ ! -d "$PMAI_HOME/skills/$sk" ]; then
    MISSING+=("$sk")
  fi
done
if [ ${#MISSING[@]} -eq 0 ]; then
  ok "All ${#EXPECTED_SKILLS[@]} expected skills present"
else
  fail "Missing ${#MISSING[@]} skill(s): ${MISSING[*]}"
fi

check_skill_exposure_dir "Claude Code" "$CLAUDE_SKILLS" "~/.claude/skills"
check_skill_exposure_dir "Codex" "$CODEX_SKILLS" "~/.codex/skills"
check_codex_prompt_dir "$CODEX_PROMPTS" "~/.codex/prompts"
check_opencode_command_dir "$OPENCODE_COMMANDS" "~/.config/opencode/commands"
check_opencode_cli

# 5. Working tree clean
echo ""
echo "─── 5. ~/.pmai/ working tree ───"
if [ -d "$PMAI_HOME/.git" ]; then
  cd "$PMAI_HOME"
  if git diff --quiet 2>/dev/null && git diff --cached --quiet 2>/dev/null; then
    ok "Working tree clean"
  else
    warn "Working tree dirty — uncommitted changes in ~/.pmai/ 影响所有消费仓行为"
  fi
fi

# 6. Remote reachable
echo ""
echo "─── 6. Remote reachable ───"
if [ -d "$PMAI_HOME/.git" ]; then
  cd "$PMAI_HOME"
  REMOTE_URL=$(git remote get-url origin 2>/dev/null || echo "")
  if [ -z "$REMOTE_URL" ]; then
    warn "No origin remote configured (升级会失败)"
  elif timeout 10 git ls-remote origin HEAD >/dev/null 2>&1; then
    ok "Remote $REMOTE_URL reachable"
  else
    warn "Remote $REMOTE_URL unreachable (SSH key / network / repo access?)"
  fi
fi

# 7. Claude Code Bash 工具子进程 PATH
#
# Claude Code 的 Bash 工具开 bash 子进程（不读 zsh 的 .zshrc），macOS 上
# login bash 读 .bash_profile。zsh 用户在 terminal 加完 PATH 之后，chat 里
# 跑 pmai 仍可能 not found —— 这个检测把盲点暴露出来。
echo ""
echo "─── 7. Claude Code Bash 工具子进程 PATH ───"
if bash -lc 'command -v pmai >/dev/null 2>&1'; then
  ok "bash -lc 能调到 pmai（Claude Code 内 AI 可调）"
else
  # 算修复目标 rc：macOS 上 login bash 优先 .bash_profile
  if [ -f "$HOME/.bash_profile" ]; then
    FIX_RC="$HOME/.bash_profile"
  elif [ -f "$HOME/.bashrc" ]; then
    FIX_RC="$HOME/.bashrc"
  else
    FIX_RC="$HOME/.bash_profile"
  fi
  warn "bash -lc 调不到 pmai — Claude Code 内 AI 跑 pmai 会 not found"
  echo "      修复：echo 'export PATH=\"\$HOME/.pmai/bin:\$PATH\"' >> $FIX_RC"
fi

# 8. gstack readiness
echo ""
echo "─── 8. gstack prerequisite ───"
GSTACK_BIN=$(command -v gstack 2>/dev/null || true)
if [ -n "$GSTACK_BIN" ]; then
  ok "gstack command found: $GSTACK_BIN"
elif [ -d "$HOME/.claude/skills/gstack" ]; then
  if [ -f "$HOME/.claude/skills/gstack/VERSION" ]; then
    ok "gstack skill found at ~/.claude/skills/gstack ($(cat "$HOME/.claude/skills/gstack/VERSION" 2>/dev/null || echo unknown))"
  else
    ok "gstack skill found at ~/.claude/skills/gstack"
  fi
else
  warn "gstack 未检测到 — 初始化和非 Web build 不受影响；Web 验收需使用 gstack 或其它主动浏览器适配器；参考：https://github.com/garrytan/gstack"
fi

# 9. gstack browser/design diagnostics
echo ""
echo "─── 9. gstack browser/design diagnostics ───"
GSTACK_BROWSER_CHECK="$PMAI_HOME/scripts/check-gstack-browser.sh"
if [ -f "$GSTACK_BROWSER_CHECK" ]; then
  if [ "$BROWSER_SMOKE" = "1" ]; then
    if bash "$GSTACK_BROWSER_CHECK" --browser-smoke; then
      ok "active gstack browser smoke passed"
    else
      fail "active gstack browser smoke failed — browser-backed visual/behavior audits cannot be treated as passed"
    fi
  elif bash "$GSTACK_BROWSER_CHECK" --doctor; then
    ok "passive gstack browser/design diagnostics passed (active smoke not run)"
  else
    warn "gstack browser/design diagnostics reported warnings — this may be a Codex sandbox localhost restriction, not a broken gstack install"
  fi
else
  warn "gstack browser diagnostic script missing at $GSTACK_BROWSER_CHECK — run pmai upgrade to install the latest diagnostics"
fi

echo ""
echo "════════════════════════════════════════════════════════════"
if [ "$EXIT_CODE" = "0" ] && [ "$WARN_COUNT" = "0" ]; then
  echo "Result: ✅ ALL OK ($PASS_COUNT checks passed)"
elif [ "$EXIT_CODE" = "0" ]; then
  echo "Result: ⚠️  OK with warnings ($PASS_COUNT pass / $WARN_COUNT warn)"
else
  echo "Result: ❌ FAIL ($FAIL_COUNT fail / $WARN_COUNT warn / $PASS_COUNT pass)"
fi
echo "════════════════════════════════════════════════════════════"

exit $EXIT_CODE
