#!/usr/bin/env bash
# pmai-doctor — Integrity self-check (covers §8 critical gaps from design doc)
#
# Checks:
#   1. ~/.pmai/ exists + is a git repo
#   2. VERSION file is valid semver
#   3. All expected skills present (~/.pmai/skills/*)
#   4. All symlinks under host skill dirs resolve (no dangling)
#   5. ~/.pmai/ working tree clean (or warn if dirty — affects consumers)
#   6. Remote reachable (short network check, non-fatal)
#   7. Claude Code Bash 工具子进程 PATH 能调到 pmai（zsh 用户常踩盲点）
#   8. gstack readiness（init-project 的外部依赖，缺失时 warning）

set -uo pipefail

PMAI_HOME="${PMAI_HOME:-$HOME/.pmai}"
CLAUDE_SKILLS="$HOME/.claude/skills"
CODEX_SKILLS="${CODEX_HOME:-$HOME/.codex}/skills"
SKILL_PREFIX="pmai-"
BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
CLI_ROOT="$(cd "$BIN_DIR/.." && pwd)"

EXIT_CODE=0
PASS_COUNT=0
WARN_COUNT=0
FAIL_COUNT=0

usage() {
  cat <<EOF
Usage:
  pmai doctor

Checks global PMAI install integrity:
  - ~/.pmai source, VERSION, expected skills
  - ~/.claude/skills/pmai-* and ~/.codex/skills/pmai-* exposure drift and dangling symlinks
  - working tree, remote reachability, Claude Code bash PATH
  - gstack readiness for /pmai-init-project
EOF
}

ok()   { echo "  ✅ $*"; PASS_COUNT=$((PASS_COUNT + 1)); }
warn() { echo "  ⚠️  $*"; WARN_COUNT=$((WARN_COUNT + 1)); }
fail() { echo "  ❌ $*"; FAIL_COUNT=$((FAIL_COUNT + 1)); EXIT_CODE=1; }

case "${1:-}" in
  --help|-h|help) usage; exit 0 ;;
  "") ;;
  *) echo "❌ unknown flag: $1" >&2; usage >&2; exit 2 ;;
esac

echo "════════════════════════════════════════════════════════════"
echo "  PMAI Doctor — integrity self-check"
echo "════════════════════════════════════════════════════════════"
echo "  CLI source:   $CLI_ROOT"
echo "  Audit target: $PMAI_HOME"
if [ "$CLI_ROOT" != "$PMAI_HOME" ] && [ -x "$PMAI_HOME/bin/pmai" ]; then
  echo "  Note: repo-local CLI is validating the installed PMAI_HOME."
  echo "        To test the installed user-facing CLI, run: $PMAI_HOME/bin/pmai doctor"
fi

# 1. ~/.pmai/ exists + is git repo
echo ""
echo "─── 1. Framework source ───"
if [ ! -d "$PMAI_HOME" ]; then
  fail "$PMAI_HOME 不存在（未安装；运行 pmai install）"
  echo ""
  echo "════════════════════════════════════════════════════════════"
  echo "Result: ❌ FAIL ($FAIL_COUNT) / ⚠️  $WARN_COUNT / ✅ $PASS_COUNT"
  exit 1
fi
ok "$PMAI_HOME exists"

if [ ! -d "$PMAI_HOME/.git" ]; then
  fail "$PMAI_HOME 不是 git 仓（损坏 / 半完整；建议重装：pmai uninstall && pmai install）"
else
  ok "$PMAI_HOME is a git repo"
fi

# 2. VERSION 文件
echo ""
echo "─── 2. VERSION file ───"
if [ ! -f "$PMAI_HOME/VERSION" ]; then
  fail "VERSION 文件缺失"
else
  VER=$(cat "$PMAI_HOME/VERSION")
  if [[ "$VER" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    ok "VERSION = $VER (valid semver)"
  else
    warn "VERSION = $VER 不是标准 semver (X.Y.Z)"
  fi
fi

# 3. Skills 全勤
echo ""
echo "─── 3. Skills in ~/.pmai/skills/ ───"
# 期望全勤的 skill —— 必须与 skills/ 目录（除 _shared）完全一致。
# ⚠️ 加 / 删 skill 时必须同步本清单 —— 否则 pmai upgrade 的 doctor 自检会误判「缺 skill」触发回滚
#    （reshape 删 req-analysis、加 build/pmai-close/pmai-design/mockup/status 时漏改本清单的教训）。
#    tests/test-doctor-skills.sh 对本清单与 skills/ 目录做全等校验，漏同步会在 run-all 红掉。
EXPECTED_SKILLS=(
  # 活跃集（reshape 后 PM 日常入口）
  init-project design mockup build close publish-to-lark status
  # 按需主动调（brownfield / 项目方向 / 照站对齐）
  strategy codebase-audit mirror-site
  # 按需辅助：小改 / 轻沉淀 / 放弃当前工作 / 反向 PRD / 说人话磨文 / 讨论换高度
  quick-fix deposit cancel prd-writing humanize meta
  # 框架自身维护
  pmai-upgrade skill-improve
)

expected_exposed_skill_names() {
  local sk
  for sk in "${EXPECTED_SKILLS[@]}"; do
    case "$sk" in
      pmai-*) echo "$sk" ;;
      *) echo "${SKILL_PREFIX}${sk}" ;;
    esac
  done | sort -u
}

actual_exposed_skill_names() {
  local exposure_dir="$1"
  local s
  for s in "$exposure_dir"/${SKILL_PREFIX}*; do
    [ -e "$s" ] || [ -L "$s" ] || continue
    basename "$s"
  done | sort -u
}

repair_empty_exposure_dir() {
  local label="$1"
  local exposure_dir="$2"
  local skill_dir skill_name dst count

  [ -d "$PMAI_HOME/skills" ] || return 1
  mkdir -p "$exposure_dir" || return 1

  count=0
  for skill_dir in "$PMAI_HOME"/skills/*/; do
    [ -d "$skill_dir" ] || continue
    skill_name=$(basename "$skill_dir")
    case "$skill_name" in
      _shared)  dst="$exposure_dir/_shared" ;;
      pmai-*)   dst="$exposure_dir/$skill_name" ;;
      *)        dst="$exposure_dir/${SKILL_PREFIX}${skill_name}" ;;
    esac

    if [ -e "$dst" ] && [ ! -L "$dst" ]; then
      warn "$label exposure repair skipped non-symlink path: $dst"
      return 1
    fi
    rm -f "$dst" 2>/dev/null || return 1
    ln -s "${skill_dir%/}" "$dst" || return 1
    count=$((count + 1))
  done

  ok "$label initial skill exposure repaired ($count symlink(s) created)"
  return 0
}

check_skill_exposure_dir() {
  local label="$1"
  local exposure_dir="$2"
  local display_path="$3"
  local s count stale_exposed missing_exposed
  local dangling=()

  echo ""
  echo "─── 4. Skill symlinks ($label: ${display_path}/${SKILL_PREFIX}*) ───"
  count=0
  for s in "$exposure_dir"/${SKILL_PREFIX}* "$exposure_dir/_shared"; do
    [ -e "$s" ] || [ -L "$s" ] || continue
    if [ -L "$s" ]; then
      if [ ! -e "$s" ]; then
        dangling+=("$s")
      fi
      count=$((count + 1))
    fi
  done
  if [ "$count" = "0" ]; then
    if repair_empty_exposure_dir "$label" "$exposure_dir"; then
      dangling=()
      count=0
      for s in "$exposure_dir"/${SKILL_PREFIX}* "$exposure_dir/_shared"; do
        [ -e "$s" ] || [ -L "$s" ] || continue
        if [ -L "$s" ]; then
          if [ ! -e "$s" ]; then
            dangling+=("$s")
          fi
          count=$((count + 1))
        fi
      done
    fi
  fi
  if [ "$count" = "0" ]; then
    fail "No skill symlinks found (${display_path}/${SKILL_PREFIX}*). 跑 pmai install 或 pmai upgrade。"
  elif [ ${#dangling[@]} -gt 0 ]; then
    fail "Dangling symlinks: ${dangling[*]} (~/.pmai/ 可能被损坏；建议 pmai uninstall && pmai install)"
  else
    ok "$count skill symlink(s) all resolve"
  fi

  if [ "$count" != "0" ]; then
    stale_exposed=$(comm -23 <(actual_exposed_skill_names "$exposure_dir") <(expected_exposed_skill_names) || true)
    missing_exposed=$(comm -13 <(actual_exposed_skill_names "$exposure_dir") <(expected_exposed_skill_names) || true)
    if [ -n "$stale_exposed" ]; then
      fail "$label stale exposed skill symlink(s): $(echo "$stale_exposed" | tr '\n' ' ') — run pmai upgrade to resync"
    fi
    if [ -n "$missing_exposed" ]; then
      fail "$label missing exposed skill symlink(s): $(echo "$missing_exposed" | tr '\n' ' ') — run pmai upgrade to resync"
    fi
    if [ -z "$stale_exposed" ] && [ -z "$missing_exposed" ] && [ ${#dangling[@]} -eq 0 ]; then
      ok "$label $(expected_exposed_skill_names | wc -l | tr -d ' ') exposed skill name(s) match current skills"
    fi
  fi
}

MISSING=()
for sk in "${EXPECTED_SKILLS[@]}"; do
  if [ ! -d "$PMAI_HOME/skills/$sk" ]; then
    MISSING+=("$sk")
  fi
done
if [ ${#MISSING[@]} -eq 0 ]; then
  ok "All ${#EXPECTED_SKILLS[@]} expected skills present"
else
  fail "Missing ${#MISSING[@]} skill(s): ${MISSING[*]}"
fi

check_skill_exposure_dir "Claude Code" "$CLAUDE_SKILLS" "~/.claude/skills"
check_skill_exposure_dir "Codex" "$CODEX_SKILLS" "~/.codex/skills"

# 5. Working tree clean
echo ""
echo "─── 5. ~/.pmai/ working tree ───"
if [ -d "$PMAI_HOME/.git" ]; then
  cd "$PMAI_HOME"
  if git diff --quiet 2>/dev/null && git diff --cached --quiet 2>/dev/null; then
    ok "Working tree clean"
  else
    warn "Working tree dirty — uncommitted changes in ~/.pmai/ 影响所有消费仓行为"
  fi
fi

# 6. Remote reachable
echo ""
echo "─── 6. Remote reachable ───"
if [ -d "$PMAI_HOME/.git" ]; then
  cd "$PMAI_HOME"
  REMOTE_URL=$(git remote get-url origin 2>/dev/null || echo "")
  if [ -z "$REMOTE_URL" ]; then
    warn "No origin remote configured (升级会失败)"
  elif timeout 10 git ls-remote origin HEAD >/dev/null 2>&1; then
    ok "Remote $REMOTE_URL reachable"
  else
    warn "Remote $REMOTE_URL unreachable (SSH key / network / repo access?)"
  fi
fi

# 7. Claude Code Bash 工具子进程 PATH
#
# Claude Code 的 Bash 工具开 bash 子进程（不读 zsh 的 .zshrc），macOS 上
# login bash 读 .bash_profile。zsh 用户在 terminal 加完 PATH 之后，chat 里
# 跑 pmai 仍可能 not found —— 这个检测把盲点暴露出来。
echo ""
echo "─── 7. Claude Code Bash 工具子进程 PATH ───"
if bash -lc 'command -v pmai >/dev/null 2>&1'; then
  ok "bash -lc 能调到 pmai（Claude Code 内 AI 可调）"
else
  # 算修复目标 rc：macOS 上 login bash 优先 .bash_profile
  if [ -f "$HOME/.bash_profile" ]; then
    FIX_RC="$HOME/.bash_profile"
  elif [ -f "$HOME/.bashrc" ]; then
    FIX_RC="$HOME/.bashrc"
  else
    FIX_RC="$HOME/.bash_profile"
  fi
  warn "bash -lc 调不到 pmai — Claude Code 内 AI 跑 pmai 会 not found"
  echo "      修复：echo 'export PATH=\"\$HOME/.pmai/bin:\$PATH\"' >> $FIX_RC"
fi

# 8. gstack readiness
echo ""
echo "─── 8. gstack prerequisite ───"
GSTACK_BIN=$(command -v gstack 2>/dev/null || true)
if [ -n "$GSTACK_BIN" ]; then
  ok "gstack command found: $GSTACK_BIN"
elif [ -d "$HOME/.claude/skills/gstack" ]; then
  if [ -f "$HOME/.claude/skills/gstack/VERSION" ]; then
    ok "gstack skill found at ~/.claude/skills/gstack ($(cat "$HOME/.claude/skills/gstack/VERSION" 2>/dev/null || echo unknown))"
  else
    ok "gstack skill found at ~/.claude/skills/gstack"
  fi
else
  warn "gstack 未检测到 — /pmai-init-project 会失败；参考：https://github.com/garrytan/gstack"
fi

echo ""
echo "════════════════════════════════════════════════════════════"
if [ "$EXIT_CODE" = "0" ] && [ "$WARN_COUNT" = "0" ]; then
  echo "Result: ✅ ALL OK ($PASS_COUNT checks passed)"
elif [ "$EXIT_CODE" = "0" ]; then
  echo "Result: ⚠️  OK with warnings ($PASS_COUNT pass / $WARN_COUNT warn)"
else
  echo "Result: ❌ FAIL ($FAIL_COUNT fail / $WARN_COUNT warn / $PASS_COUNT pass)"
fi
echo "════════════════════════════════════════════════════════════"

exit $EXIT_CODE
