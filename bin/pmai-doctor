#!/usr/bin/env bash
# pmai-doctor — Integrity self-check (covers §8 critical gaps from design doc)
#
# Checks:
#   1. ~/.pmai/ exists + is a git repo
#   2. VERSION file is valid semver
#   3. All expected skills present (~/.pmai/skills/*)
#   4. All symlinks under host skill dirs resolve (no dangling)
#   5. OpenCode slash commands and Kimi Code native host surface aligned
#   6. ~/.pmai/ working tree clean (or warn if dirty — affects consumers)
#   7. Remote reachable (short network check, non-fatal)
#   8. Claude Code Bash 工具子进程 PATH 能调到 pmai（zsh 用户常踩盲点）
#   9. gstack readiness（可选浏览器/设计适配器，缺失时 warning）
#   10. gstack browser/design diagnostics（mockup 的可选外部能力）

set -uo pipefail

PMAI_HOME="${PMAI_HOME:-$HOME/.pmai}"
CLAUDE_SKILLS="$HOME/.claude/skills"
CODEX_SKILLS="${CODEX_HOME:-$HOME/.codex}/skills"
KIMI_CODE_HOME="${KIMI_CODE_HOME:-$HOME/.kimi-code}"
KIMI_SKILLS="$KIMI_CODE_HOME/skills"
KIMI_CONFIG="$KIMI_CODE_HOME/config.toml"
OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
OPENCODE_COMMANDS="$OPENCODE_CONFIG_DIR/commands"
SKILL_PREFIX="pmai-"
BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
CLI_ROOT="$(cd "$BIN_DIR/.." && pwd)"
ORIGINAL_ARGS=("$@")

EXIT_CODE=0
PASS_COUNT=0
WARN_COUNT=0
FAIL_COUNT=0
BROWSER_SMOKE=0
MODE="check"
MODE_EXPLICIT=0
OUTPUT_FORMAT="human"
CURRENT_CATEGORY="framework"
RESULTS_FILE=""
DOCTOR_START_CWD="$(pwd -P 2>/dev/null || true)"
FRAMEWORK_INSTALLED=0
FRAMEWORK_VERSION="unknown"
FRAMEWORK_HEAD=""
FRAMEWORK_BRANCH=""
FRAMEWORK_REMOTE_URL=""
FRAMEWORK_REMOTE_HEAD=""
FRAMEWORK_WORKTREE="unknown"
UPDATE_AVAILABLE="unknown"
PROJECT_KIND="none"
PROJECT_ROOT=""
PROJECT_HOOKS="not_applicable"
PROJECT_OPENCODE="not_applicable"
PROJECT_GIT_HOOK="not_applicable"
CONSUMER_TOPOLOGY="not_applicable"
CONSUMER_PHASE="not_applicable"
CONSUMER_AUDIT_FILE=""
LEGACY_LOCAL_COPY="false"
FRAMEWORK_BROKEN=0

usage() {
  cat <<EOF
Usage:
  pmai doctor [--check] [--json] [--browser-smoke]
  pmai doctor --repair [--json] [--browser-smoke]

Checks global PMAI install integrity and the current consumer repository:
  - ~/.pmai source, VERSION, expected skills
  - ~/.claude/skills/pmai-* and ~/.codex/skills/pmai-* exposure drift and dangling symlinks
  - $KIMI_CODE_HOME/skills/pmai-* native /skill:pmai-* exposure and PMAI-managed hooks
  - ~/.config/opencode/commands/pmai-*.md OpenCode slash command exposure
  - working tree, remote reachability, Claude Code bash PATH
  - optional gstack/browser readiness
  - passive gstack browser/design diagnostics for /pmai-mockup
  - consumer document placement, project definition, mockups, lifecycle, and recovery structure
  - with --browser-smoke: actively launch gstack browse and fail if unusable

Modes:
  --check    Read-only diagnostics (default).
  --repair   Repair PMAI-managed global host entries, then verify.
  --json     Emit one stable JSON object on stdout.
EOF
}

record_result() {
  local level="$1"
  shift

  [ "$OUTPUT_FORMAT" = "json" ] || return 0
  printf '%s\0%s\0%s\0' "$level" "$CURRENT_CATEGORY" "$*" >> "$RESULTS_FILE"
}

ok() {
  record_result "pass" "$*" || exit 2
  echo "  ✅ $*"
  PASS_COUNT=$((PASS_COUNT + 1))
}

warn() {
  record_result "warning" "$*" || exit 2
  echo "  ⚠️  $*"
  WARN_COUNT=$((WARN_COUNT + 1))
}

fail() {
  record_result "fail" "$*" || exit 2
  echo "  ❌ $*"
  FAIL_COUNT=$((FAIL_COUNT + 1))
  if [ "$CURRENT_CATEGORY" != "consumer" ]; then
    FRAMEWORK_BROKEN=1
  fi
  EXIT_CODE=1
}

emit_json() {
  local conclusion recommended_action

  if [ "$FRAMEWORK_BROKEN" = "1" ] || [ "$FRAMEWORK_INSTALLED" != "1" ]; then
    conclusion="broken"
    if [ "$FRAMEWORK_INSTALLED" = "0" ]; then
      recommended_action="install"
    else
      recommended_action="repair"
    fi
  elif [ "$CONSUMER_TOPOLOGY" = "invalid" ]; then
    conclusion="consumer_invalid"
    recommended_action="review_consumer_structure"
  elif [ "$UPDATE_AVAILABLE" = "true" ]; then
    conclusion="upgrade_available"
    recommended_action="upgrade"
  elif { [ "$PROJECT_HOOKS" != "current" ] && [ "$PROJECT_HOOKS" != "not_applicable" ]; } \
    || { [ "$PROJECT_OPENCODE" != "current" ] && [ "$PROJECT_OPENCODE" != "not_applicable" ]; } \
    || { [ "$PROJECT_GIT_HOOK" != "current" ] && [ "$PROJECT_GIT_HOOK" != "not_applicable" ]; } \
    || [ "$CONSUMER_TOPOLOGY" = "sync_required" ] \
    || [ "$LEGACY_LOCAL_COPY" = "true" ]; then
    conclusion="consumer_sync_required"
    if [ "$LEGACY_LOCAL_COPY" = "true" ]; then
      recommended_action="remove_legacy_copy"
    elif [ "$PROJECT_HOOKS" = "checker_missing" ]; then
      recommended_action="upgrade"
    elif [ "$PROJECT_OPENCODE" = "checker_missing" ] \
      || [ "$PROJECT_GIT_HOOK" = "checker_missing" ]; then
      recommended_action="upgrade"
    elif [ "$PROJECT_HOOKS" != "current" ] \
      && [ "$PROJECT_HOOKS" != "not_applicable" ]; then
      recommended_action="refresh_project_hooks"
    elif [ "$PROJECT_OPENCODE" != "current" ] \
      && [ "$PROJECT_OPENCODE" != "not_applicable" ]; then
      recommended_action="refresh_opencode_project"
    elif [ "$PROJECT_GIT_HOOK" != "current" ] \
      && [ "$PROJECT_GIT_HOOK" != "not_applicable" ]; then
      recommended_action="refresh_git_hook"
    elif [ "$CONSUMER_TOPOLOGY" = "sync_required" ] \
      && [ -n "$CONSUMER_AUDIT_FILE" ] \
      && python3 - "$CONSUMER_AUDIT_FILE" <<'PY' >/dev/null 2>&1
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    findings = json.load(handle).get("findings", [])
raise SystemExit(0 if any(
    item.get("kind") == "compatibility_declaration_required"
    for item in findings
) else 1)
PY
    then
      recommended_action="declare_consumer_compatibility"
    else
      recommended_action="review_consumer_structure"
    fi
  else
    conclusion="healthy"
    recommended_action="none"
  fi

  python3 - "$RESULTS_FILE" "$MODE" "$conclusion" "$recommended_action" \
    "$PASS_COUNT" "$WARN_COUNT" "$FAIL_COUNT" \
    "$PMAI_HOME" "$FRAMEWORK_INSTALLED" "$FRAMEWORK_VERSION" \
    "$FRAMEWORK_HEAD" "$FRAMEWORK_BRANCH" "$FRAMEWORK_REMOTE_URL" \
    "$FRAMEWORK_REMOTE_HEAD" "$FRAMEWORK_WORKTREE" "$UPDATE_AVAILABLE" \
    "$PROJECT_KIND" "$PROJECT_ROOT" "$PROJECT_HOOKS" "$PROJECT_OPENCODE" \
    "$PROJECT_GIT_HOOK" "$CONSUMER_TOPOLOGY" "$CONSUMER_PHASE" \
    "$LEGACY_LOCAL_COPY" "$CONSUMER_AUDIT_FILE" <<'PY'
import json
import sys

(
    results_path,
    mode,
    conclusion,
    recommended_action,
    passed,
    warned,
    failed,
    framework_home,
    framework_installed,
    framework_version,
    framework_head,
    framework_branch,
    framework_remote_url,
    framework_remote_head,
    framework_worktree,
    update_available,
    project_kind,
    project_root,
    project_hooks,
    project_opencode,
    project_git_hook,
    consumer_topology,
    consumer_phase,
    legacy_local_copy,
    consumer_audit_path,
) = sys.argv[1:]

with open(results_path, "rb") as handle:
    fields = handle.read().split(b"\0")
if fields and fields[-1] == b"":
    fields.pop()
if len(fields) % 3:
    raise SystemExit("invalid doctor findings stream")
findings = [
    {
        "level": fields[index].decode("utf-8"),
        "category": fields[index + 1].decode("utf-8"),
        "message": fields[index + 2].decode("utf-8"),
    }
    for index in range(0, len(fields), 3)
]

def tri_state(value):
    if value == "true":
        return True
    if value == "false":
        return False
    return None

payload = {
    "schema_version": 1,
    "mode": mode,
    "conclusion": conclusion,
    "recommended_action": recommended_action,
    "summary": {
        "pass": int(passed),
        "warning": int(warned),
        "fail": int(failed),
    },
    "framework": {
        "home": framework_home,
        "installed": framework_installed == "1",
        "version": framework_version,
        "head": framework_head or None,
        "branch": framework_branch or None,
        "remote_url": framework_remote_url or None,
        "remote_head": framework_remote_head or None,
        "working_tree": framework_worktree,
        "update_available": tri_state(update_available),
    },
    "consumer": {
        "kind": project_kind,
        "root": project_root or None,
        "project_hooks": project_hooks,
        "opencode": project_opencode,
        "git_hook": project_git_hook,
        "topology_status": consumer_topology,
        "phase": consumer_phase,
        "legacy_local_copy": legacy_local_copy == "true",
        "audit": None,
    },
    "findings": findings,
}
if consumer_audit_path:
    try:
        with open(consumer_audit_path, encoding="utf-8") as handle:
            audit = json.load(handle)
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit(f"invalid consumer audit JSON: {exc}") from exc
    if not isinstance(audit, dict) or audit.get("schema_version") != 1:
        raise SystemExit("invalid consumer audit schema")
    payload["consumer"]["audit"] = audit
    audit_messages = {
        str(item.get("message") or "")
        for item in audit.get("findings", [])
        if isinstance(item, dict)
    }
    payload["findings"] = [
        item for item in payload["findings"]
        if not (item.get("category") == "consumer" and item.get("message") in audit_messages)
    ]
    for item in audit.get("findings", []):
        if not isinstance(item, dict):
            continue
        enriched = dict(item)
        enriched["category"] = "consumer"
        payload["findings"].append(enriched)

check_definitions = (
    ("framework_install", "PMAI 安装"),
    ("ai_tool_entry", "AI 工具接入"),
    ("required_materials", "项目必需资料"),
    ("documents_and_history", "文档与历史资料"),
    ("product_files", "原型和产品文件"),
    ("active_work", "正在进行的工作"),
    ("project_safety", "项目安全"),
)
progress_codes = {
    "ready_design_revision",
    "ready_contract_incomplete",
    "ready_target_missing",
    "ready_target_invalid",
}


def finding_area(item):
    code = str(item.get("code") or "")
    path = str(item.get("path") or "")
    if code in progress_codes:
        return None
    if code in {
        "host_rules_missing",
        "host_rules_stale",
        "host_surface_missing",
        "host_surface_untracked",
        "legacy_local_skills",
    }:
        return "ai_tool_entry"
    if path in {"AGENTS.md", "CLAUDE.md"} and code in {
        "missing_required_file",
        "managed_path_symlink",
        "managed_path_type",
        "managed_path_unreadable",
        "framework_file_untracked",
    }:
        return "ai_tool_entry"
    if code.startswith(("secret_", "gitignore_")) \
      or code in {"not_git_repository", "git_root_unreadable", "wrong_repository_root", "git_index_unreadable"} \
      or code.endswith("_symlink"):
        return "project_safety"
    if code.startswith(("project_definition_", "project_source_", "implementation_", "entrypoint_", "mockup_", "mockups_")) \
      or code in {"build_project_type_mismatch", "build_entrypoints_mismatch", "build_target_outside_root", "build_target_outside_entrypoints"}:
        return "product_files"
    if code.startswith(("work_meta_", "lifecycle_", "build_", "active_", "audit_")) \
      or code in {"unexpected_build_contract", "active_module_compatibility_ignored"}:
        return "active_work"
    if code.startswith(("docs_", "misplaced_docs_", "module_", "modules_", "legacy_")) \
      or item.get("kind") in {"legacy_compatible", "compatibility_declaration_required"}:
        return "documents_and_history"
    return "required_materials"


def add_problem(check, message, status):
    ranks = {"normal": 0, "attention": 1, "problem": 2}
    if ranks[status] > ranks.get(check["status"], -1):
        check["status"] = status
    if message and message not in check["problems"]:
        check["problems"].append(message)


checks = {
    check_id: {"id": check_id, "label": label, "status": "normal", "problems": []}
    for check_id, label in check_definitions
}
recorded_failure_areas = {
    "framework": "framework_install",
    "skills": "framework_install",
    "upgrade": "framework_install",
    "claude": "ai_tool_entry",
    "codex": "ai_tool_entry",
    "kimi": "ai_tool_entry",
    "opencode": "ai_tool_entry",
    "runtime": "ai_tool_entry",
    "browser": "ai_tool_entry",
}
framework_failure_recorded = False
for item in payload["findings"]:
    if not isinstance(item, dict) or item.get("level") != "fail":
        continue
    area = recorded_failure_areas.get(str(item.get("category") or ""))
    if area is None:
        continue
    add_problem(checks[area], str(item.get("message") or ""), "problem")
    if area == "framework_install":
        framework_failure_recorded = True

if not payload["framework"]["installed"] and not framework_failure_recorded:
    add_problem(checks["framework_install"], "PMAI 安装不完整或无法正常运行", "problem")
elif payload["framework"]["update_available"] is True:
    add_problem(checks["framework_install"], "PMAI 有新版本可以更新", "attention")

if project_kind != "consumer":
    for check_id, _label in check_definitions[2:]:
        checks[check_id]["status"] = "not_applicable"
else:
    host_states = (project_hooks, project_opencode, project_git_hook)
    if any(state in {"checker_missing", "invalid"} for state in host_states):
        add_problem(checks["ai_tool_entry"], "当前项目的 AI 工具接入无法完整检查", "problem")
    elif any(state == "drifted" for state in host_states):
        add_problem(checks["ai_tool_entry"], "当前项目的 AI 工具接入需要更新", "attention")
    if legacy_local_copy == "true":
        add_problem(checks["ai_tool_entry"], "当前项目里还有旧版 PMAI 文件", "attention")

    audit_findings = []
    if isinstance(payload["consumer"].get("audit"), dict):
        audit_findings = payload["consumer"]["audit"].get("findings", [])
    for item in audit_findings:
        if not isinstance(item, dict) or item.get("kind") == "legacy_compatible":
            continue
        area = finding_area(item)
        if area is None:
            continue
        status = "problem" if item.get("blocking") else "attention"
        add_problem(checks[area], str(item.get("message") or ""), status)

progress_notes = []
if isinstance(payload["consumer"].get("audit"), dict):
    for item in payload["consumer"]["audit"].get("findings", []):
        if isinstance(item, dict) and item.get("code") in progress_codes:
            message = str(item.get("message") or "")
            if message and message not in progress_notes:
                progress_notes.append(message)

payload["checks"] = [checks[check_id] for check_id, _label in check_definitions]
payload["product_progress"] = {
    "phase": consumer_phase if project_kind == "consumer" else "not_applicable",
    "notes": progress_notes,
}

repair_actions_by_message = {}
for item in payload["findings"]:
    if not isinstance(item, dict) or not isinstance(item.get("repair_action"), dict):
        continue
    message = str(item.get("message") or "")
    if message:
        repair_actions_by_message.setdefault(message, []).append(item["repair_action"])

action_items = []
for check in payload["checks"]:
    if check["status"] not in {"attention", "problem"}:
        continue
    repair_actions = []
    for problem in check["problems"]:
        for action in repair_actions_by_message.get(problem, []):
            if action not in repair_actions:
                repair_actions.append(action)
    action_items.append({
        "check_id": check["id"],
        "label": check["label"],
        "status": check["status"],
        "problems": list(check["problems"]),
        "repair_actions": repair_actions,
    })

notices = []


def add_notice(category, message):
    item = {"category": category, "message": message}
    if item not in notices:
        notices.append(item)


if payload["framework"]["update_available"] is None:
    add_notice("framework_currentness", "暂时无法确认 PMAI 是否为最新版")
if any(
    isinstance(item, dict)
    and item.get("category") == "browser"
    and item.get("level") == "warning"
    for item in payload["findings"]
):
    add_notice("browser_adapter", "可选浏览器能力未就绪；不影响非 Web 工作")
for item in payload["findings"]:
    if not isinstance(item, dict) or item.get("kind") != "legacy_compatible":
        continue
    message = str(item.get("message") or "")
    if message:
        add_notice("legacy_compatible", message)

payload["pm_report"] = {
    "action_items": action_items,
    "notices": notices,
    "progress": dict(payload["product_progress"]),
}
print(json.dumps(payload, ensure_ascii=False, indent=2))
PY
}

finish_doctor() {
  local exit_code="$1"

  if [ "$OUTPUT_FORMAT" = "json" ]; then
    if ! emit_json >&3; then
      exit_code=2
    fi
  fi
  if [ -n "$RESULTS_FILE" ]; then
    rm -f -- "$RESULTS_FILE"
    RESULTS_FILE=""
  fi
  if [ -n "$CONSUMER_AUDIT_FILE" ]; then
    rm -f -- "$CONSUMER_AUDIT_FILE"
    CONSUMER_AUDIT_FILE=""
  fi
  exit "$exit_code"
}

# Help belongs to the CLI source the PM invoked and must remain available even
# when the configured install is absent or incomplete. All other arguments are
# owned by the target doctor when repo-local and installed versions differ.
for arg in "$@"; do
  case "$arg" in
    --help|-h|help) usage; exit 0 ;;
  esac
done

PMAI_HOME_REAL="$PMAI_HOME"
CLI_ROOT_REAL="$(cd "$CLI_ROOT" && pwd -P)"
if [ -d "$PMAI_HOME" ]; then
  PMAI_HOME_REAL="$(cd "$PMAI_HOME" && pwd -P)"
fi
TARGET_DOCTOR="$PMAI_HOME/bin/pmai-doctor"
if [ "$CLI_ROOT_REAL" != "$PMAI_HOME_REAL" ] && [ -d "$PMAI_HOME" ]; then
  if [ ! -f "$TARGET_DOCTOR" ] || [ ! -x "$TARGET_DOCTOR" ]; then
    echo "❌ 目标 PMAI doctor 缺失或不可执行：$TARGET_DOCTOR" >&2
    exit 2
  fi
  # Cross-version diagnostics and repair are both owned by the installed
  # target. A newer checkout must not interpret or mutate another version's
  # host policy.
  export PMAI_HOME
  exec "$TARGET_DOCTOR" ${ORIGINAL_ARGS[@]+"${ORIGINAL_ARGS[@]}"}
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --check)
      if [ "$MODE_EXPLICIT" = "1" ] && [ "$MODE" != "check" ]; then
        echo "❌ --check 与 --repair 不能同时使用。" >&2
        exit 2
      fi
      MODE="check"
      MODE_EXPLICIT=1
      ;;
    --repair)
      if [ "$MODE_EXPLICIT" = "1" ] && [ "$MODE" != "repair" ]; then
        echo "❌ --check 与 --repair 不能同时使用。" >&2
        exit 2
      fi
      MODE="repair"
      MODE_EXPLICIT=1
      ;;
    --json) OUTPUT_FORMAT="json" ;;
    --browser-smoke) BROWSER_SMOKE=1 ;;
    *) echo "❌ unknown flag: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if [ "$MODE" = "repair" ]; then
  if ! source "$CLI_ROOT/scripts/_lib/global-install-lock.sh"; then
    echo "❌ 无法载入全局安装锁 helper，拒绝执行 doctor 修复。" >&2
    exit 2
  fi
  pmai_hold_global_install_lock \
    "$CLI_ROOT" "${BASH_SOURCE[0]}" \
    ${ORIGINAL_ARGS[@]+"${ORIGINAL_ARGS[@]}"} || exit $?
fi

if ! source "$CLI_ROOT/scripts/_lib/skill-links.sh"; then
  echo "❌ 无法载入 skill 入口策略，拒绝继续 doctor。" >&2
  exit 2
fi

if [ "$OUTPUT_FORMAT" = "json" ]; then
  RESULTS_FILE=$(mktemp "${TMPDIR:-/tmp}/pmai-doctor-results.XXXXXX") || {
    echo "❌ 无法创建 doctor JSON 临时文件。" >&2
    exit 2
  }
  exec 3>&1
  exec 1>/dev/null
fi

# stock macOS 没有 GNU timeout。优先使用 Homebrew 的 gtimeout；两者都
# 不存在时直接执行，与 upgrader 的兼容语义保持一致。
if ! command -v timeout >/dev/null 2>&1; then
  if command -v gtimeout >/dev/null 2>&1; then
    timeout() { gtimeout "$@"; }
  else
    timeout() { shift; "$@"; }
  fi
fi

echo "════════════════════════════════════════════════════════════"
if [ "$MODE" = "repair" ]; then
  echo "  PMAI Doctor — repair and verify"
else
  echo "  PMAI Doctor — read-only check"
fi
echo "════════════════════════════════════════════════════════════"
echo "  CLI source:   $CLI_ROOT"
echo "  Audit target: $PMAI_HOME"
if [ "$CLI_ROOT_REAL" != "$PMAI_HOME_REAL" ] && [ -x "$PMAI_HOME/bin/pmai" ]; then
  echo "  Note: repo-local CLI is validating the installed PMAI_HOME."
  echo "        To test the installed user-facing CLI, run: $PMAI_HOME/bin/pmai doctor --check"
fi

# 1. ~/.pmai/ exists + is git repo
CURRENT_CATEGORY="framework"
echo ""
echo "─── 1. Framework source ───"
if [ ! -d "$PMAI_HOME" ]; then
  fail "$PMAI_HOME 不存在（未安装；运行 pmai install）"
  echo ""
  echo "════════════════════════════════════════════════════════════"
  echo "Result: ❌ FAIL ($FAIL_COUNT) / ⚠️  $WARN_COUNT / ✅ $PASS_COUNT"
  finish_doctor 1
fi
FRAMEWORK_INSTALLED=1
ok "$PMAI_HOME exists"

if [ ! -d "$PMAI_HOME/.git" ]; then
  fail "$PMAI_HOME 不是 git 仓（损坏 / 半完整；建议重装：pmai uninstall && pmai install）"
else
  FRAMEWORK_HEAD=$(git -C "$PMAI_HOME" rev-parse HEAD 2>/dev/null || true)
  FRAMEWORK_BRANCH=$(git -C "$PMAI_HOME" symbolic-ref --short -q HEAD 2>/dev/null || true)
  ok "$PMAI_HOME is a git repo"
fi

# 2. VERSION 文件
echo ""
echo "─── 2. VERSION file ───"
if [ ! -f "$PMAI_HOME/VERSION" ]; then
  fail "VERSION 文件缺失"
else
  VER=$(cat "$PMAI_HOME/VERSION")
  FRAMEWORK_VERSION="$VER"
  if [[ "$VER" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    ok "VERSION = $VER (valid semver)"
  else
    warn "VERSION = $VER 不是标准 semver (X.Y.Z)"
  fi
fi

# 3. Skill 源资产完整性
echo ""
echo "─── 3. Skill sources in $PMAI_HOME/skills/ ───"
# 期望完整的 skill 源资产 —— 必须与 skills/ 目录（除 _shared / _internal）完全一致。
# 宿主是否暴露由 pmai_skill_is_host_exposed 另行过滤，两者不是同一清单。
# ⚠️ 加 / 删 skill 时必须同步本清单 —— 否则 pmai upgrade 的 doctor 自检会误判「缺 skill」触发回滚
#    （reshape 删 req-analysis、加 build/build-close/design/mockup/status 时漏改本清单的教训）。
#    tests/test-doctor-skills.sh 对本清单与 skills/ 目录做全等校验，漏同步会在 run-all 红掉。
EXPECTED_SKILLS=(
  # 活跃集（reshape 后 PM 日常入口）
  init-project design mockup build build-close publish-to-lark lark-sync lark-review status doctor
  # 按需主动调（项目方向 / 照站对齐）
  direction mirror-site
  # 按需辅助：小改 / 轻记录 / 放弃 build / 功能型规格文档 / 介绍型文档 / 说人话磨文 / 讨论对焦 / 会话反馈
  quick-fix record build-cancel spec-writing doc-writing humanize meta feedback
  # 框架自身维护
  pmai-upgrade
)

expected_exposed_skill_names() {
  local sk
  for sk in "${EXPECTED_SKILLS[@]}"; do
    pmai_skill_is_host_exposed "$sk" || continue
    case "$sk" in
      pmai-*) echo "$sk" ;;
      *) echo "${SKILL_PREFIX}${sk}" ;;
    esac
  done | sort -u
}

expected_skill_link_entries() {
  local sk exposed_name

  for sk in "${EXPECTED_SKILLS[@]}"; do
    pmai_skill_is_host_exposed "$sk" || continue
    case "$sk" in
      pmai-*) exposed_name="$sk" ;;
      *) exposed_name="${SKILL_PREFIX}${sk}" ;;
    esac
    printf '%s\t%s\n' "$exposed_name" "$PMAI_HOME/skills/$sk"
  done
  printf '_shared\t%s\n' "$PMAI_HOME/skills/_shared"
}

actual_exposed_skill_names() {
  local exposure_dir="$1"
  local s
  for s in "$exposure_dir"/${SKILL_PREFIX}*; do
    [ -e "$s" ] || [ -L "$s" ] || continue
    basename "$s"
  done | sort -u
}

expected_opencode_command_names() {
  expected_exposed_skill_names | sed 's/$/.md/' | sort -u
}

actual_opencode_command_names() {
  local command_dir="$1"
  local s
  for s in "$command_dir"/${SKILL_PREFIX}*.md; do
    [ -e "$s" ] || continue
    basename "$s"
  done | sort -u
}

count_opencode_commands() {
  local command_dir="$1"
  local s count

  count=0
  for s in "$command_dir"/${SKILL_PREFIX}*.md; do
    [ -e "$s" ] || continue
    count=$((count + 1))
  done
  echo "$count"
}

repair_opencode_commands() {
  if [ ! -f "$PMAI_HOME/scripts/install-opencode-commands.sh" ]; then
    return 1
  fi

  if PMAI_HOME="$PMAI_HOME" OPENCODE_CONFIG_DIR="$OPENCODE_CONFIG_DIR" \
    bash "$PMAI_HOME/scripts/install-opencode-commands.sh" --global >/dev/null 2>&1; then
    return 0
  fi

  return 1
}

opencode_commands_match() {
  PMAI_HOME="$PMAI_HOME" OPENCODE_CONFIG_DIR="$OPENCODE_CONFIG_DIR" \
    bash "$PMAI_HOME/scripts/install-opencode-commands.sh" \
      --global --check >/dev/null 2>&1
}

repair_skill_exposure_dir() {
  local label="$1"
  local exposure_dir="$2"
  local expected_name expected_target path actual_target stale count

  [ -d "$PMAI_HOME/skills" ] || return 1
  mkdir -p "$exposure_dir" || return 1

  count=0
  while IFS= read -r stale; do
    [ -n "$stale" ] || continue
    path="$exposure_dir/$stale"
    if pmai_skill_link_is_managed "$PMAI_HOME/skills" "$path"; then
      rm -- "$path" || return 1
      count=$((count + 1))
    fi
  done < <(comm -23 <(actual_exposed_skill_names "$exposure_dir") <(expected_exposed_skill_names) || true)

  while IFS=$'\t' read -r expected_name expected_target; do
    path="$exposure_dir/$expected_name"
    [ -d "$expected_target" ] || continue
    if [ "$expected_name" = "_shared" ]; then
      if [ -L "$path" ] && [ "$(readlink "$path")" = "$expected_target" ]; then
        continue
      fi
      if pmai_install_shared_link "$expected_target" "$path"; then
        count=$((count + 1))
      fi
      continue
    fi
    if [ -L "$path" ]; then
      actual_target=$(readlink "$path")
      if [ "$actual_target" = "$expected_target" ]; then
        continue
      fi
      pmai_skill_link_is_managed "$PMAI_HOME/skills" "$path" || continue
      rm -- "$path" || return 1
    elif [ -e "$path" ]; then
      continue
    fi
    ln -s "$expected_target" "$path" || return 1
    count=$((count + 1))
  done < <(expected_skill_link_entries)

  if [ "$count" -gt 0 ]; then
    ok "$label skill exposure repaired ($count managed link change(s))"
  fi
  return 0
}

check_skill_exposure_dir() {
  local label="$1"
  local exposure_dir="$2"
  local display_path="$3"
  local s count stale_exposed retired_count entry_count
  local expected_name expected_target path actual_target
  local invalid=()

  echo ""
  echo "─── 4. Skill symlinks ($label: ${display_path}/${SKILL_PREFIX}*) ───"
  if [ "$MODE" = "repair" ]; then
    if retired_count=$(pmai_prune_managed_hidden_skill_links "$PMAI_HOME/skills" "$exposure_dir"); then
      if [ "$retired_count" -gt 0 ]; then
        ok "$label retired $retired_count PMAI-managed hidden skill link(s)"
      fi
    else
      fail "$label could not remove retired PMAI-managed hidden skill links"
    fi
    if ! repair_skill_exposure_dir "$label" "$exposure_dir"; then
      fail "$label could not repair PMAI-managed skill exposure"
    fi
  else
    if retired_count=$(pmai_count_managed_hidden_skill_links "$PMAI_HOME/skills" "$exposure_dir"); then
      if [ "$retired_count" -gt 0 ]; then
        fail "$label has $retired_count PMAI-managed hidden skill link(s); run pmai doctor --repair"
      fi
    else
      fail "$label could not inspect retired PMAI-managed hidden skill links"
    fi
  fi
  entry_count=0
  for s in "$exposure_dir"/${SKILL_PREFIX}* "$exposure_dir/_shared"; do
    [ -e "$s" ] || [ -L "$s" ] || continue
    entry_count=$((entry_count + 1))
  done
  if [ "$entry_count" = "0" ]; then
    fail "No skill symlinks found (${display_path}/${SKILL_PREFIX}*). Run pmai doctor --repair."
    return
  fi

  count=0
  while IFS=$'\t' read -r expected_name expected_target; do
    path="$exposure_dir/$expected_name"
    if [ ! -L "$path" ]; then
      if [ -e "$path" ]; then
        invalid+=("$expected_name:not-symlink")
      else
        invalid+=("$expected_name:missing")
      fi
      continue
    fi
    actual_target=$(readlink "$path")
    if [ "$actual_target" != "$expected_target" ]; then
      invalid+=("$expected_name:wrong-target")
    elif [ ! -e "$path" ]; then
      invalid+=("$expected_name:dangling")
    else
      count=$((count + 1))
    fi
  done < <(expected_skill_link_entries)

  stale_exposed=$(comm -23 <(actual_exposed_skill_names "$exposure_dir") <(expected_exposed_skill_names) || true)
  if [ -n "$stale_exposed" ]; then
    fail "$label stale exposed skill entry(s): $(echo "$stale_exposed" | tr '\n' ' ') — run pmai upgrade to resync"
  fi
  if [ ${#invalid[@]} -gt 0 ]; then
    fail "$label invalid skill entry(s): ${invalid[*]} — expected exact symlinks into $PMAI_HOME/skills"
  fi
  if [ -z "$stale_exposed" ] && [ ${#invalid[@]} -eq 0 ]; then
    ok "$label $count skill symlink(s) exactly match current PMAI sources"
  fi
}

check_opencode_command_dir() {
  local command_dir="$1"
  local display_path="$2"
  local count

  echo ""
  echo "─── 4b. OpenCode slash commands (${display_path}/${SKILL_PREFIX}*.md) ───"
  count=$(count_opencode_commands "$command_dir")

  if opencode_commands_match; then
    ok "OpenCode $count slash command file(s) exactly match current PMAI render"
    return
  fi
  if [ "$MODE" = "repair" ] && repair_opencode_commands && opencode_commands_match; then
    count=$(count_opencode_commands "$command_dir")
    ok "OpenCode slash commands repaired and verified ($count file(s))"
    return
  fi
  fail "OpenCode slash commands are missing, stale, modified, or unreadable (${display_path}/${SKILL_PREFIX}*.md); run pmai doctor --repair"
}

check_opencode_cli() {
  local opencode_bin

  echo ""
  echo "─── 4c. OpenCode CLI ───"
  opencode_bin=$(command -v opencode 2>/dev/null || true)
  if [ -n "$opencode_bin" ]; then
    ok "opencode command found: $opencode_bin"
  else
    warn "opencode command not found — OpenCode 主控入口已可安装，但本机还不能直接运行 OpenCode CLI"
  fi
}

find_kimi_bin() {
  local kimi_bin
  kimi_bin=$(command -v kimi 2>/dev/null || true)
  if [ -z "$kimi_bin" ] && [ -x "$KIMI_CODE_HOME/bin/kimi" ]; then
    kimi_bin="$KIMI_CODE_HOME/bin/kimi"
  fi
  echo "$kimi_bin"
}

check_kimi_host() {
  local kimi_bin manager_out manager_rc

  echo ""
  echo "─── 4d. Kimi Code native host ───"
  kimi_bin=$(find_kimi_bin)
  if [ -n "$kimi_bin" ]; then
    ok "Kimi Code command found: $kimi_bin"
  else
    warn "Kimi Code command not found — native /skill:pmai-* exposure 已安装，但本机还不能直接运行 Kimi Code"
  fi

  if [ ! -f "$KIMI_CONFIG" ]; then
    warn "Kimi config 不存在：${KIMI_CONFIG}；先启动一次 Kimi Code，再运行 pmai doctor --repair 安装原生 hooks"
    return
  fi

  if [ -n "$kimi_bin" ]; then
    if "$kimi_bin" doctor config "$KIMI_CONFIG" >/dev/null 2>&1; then
      ok "Kimi config.toml is valid"
    else
      warn "Kimi config.toml 无法通过 kimi doctor；未自动改写 hooks"
      return
    fi
  fi

  if [ ! -f "$PMAI_HOME/scripts/manage-kimi-hooks.py" ]; then
    fail "Kimi hook manager 缺失：$PMAI_HOME/scripts/manage-kimi-hooks.py"
    return
  fi

  manager_out=$(KIMI_CODE_HOME="$KIMI_CODE_HOME" python3 "$PMAI_HOME/scripts/manage-kimi-hooks.py" check --config "$KIMI_CONFIG" 2>&1)
  manager_rc=$?
  if [ "$manager_rc" = "0" ]; then
    ok "Kimi Code PMAI-managed hooks match current framework"
    return
  fi
  if [ "$manager_rc" = "1" ]; then
    if [ "$MODE" = "repair" ] && KIMI_CODE_HOME="$KIMI_CODE_HOME" \
      python3 "$PMAI_HOME/scripts/manage-kimi-hooks.py" \
      install --config "$KIMI_CONFIG" >/dev/null 2>&1; then
      manager_out=$(KIMI_CODE_HOME="$KIMI_CODE_HOME" \
        python3 "$PMAI_HOME/scripts/manage-kimi-hooks.py" \
        check --config "$KIMI_CONFIG" 2>&1)
      manager_rc=$?
      if [ "$manager_rc" = "0" ]; then
        ok "Kimi Code PMAI-managed hooks repaired"
        return
      fi
      fail "Kimi Code hooks 修复后校验仍未通过：$manager_out"
      return
    fi
  fi
  fail "Kimi Code hooks 未就绪：$manager_out"
}

MISSING=()
CURRENT_CATEGORY="skills"
for sk in "${EXPECTED_SKILLS[@]}"; do
  if [ ! -d "$PMAI_HOME/skills/$sk" ]; then
    MISSING+=("$sk")
  fi
done
if [ ${#MISSING[@]} -eq 0 ]; then
  ok "All ${#EXPECTED_SKILLS[@]} expected skill source directories present"
else
  fail "Missing ${#MISSING[@]} skill(s): ${MISSING[*]}"
fi

CURRENT_CATEGORY="claude"
check_skill_exposure_dir "Claude Code" "$CLAUDE_SKILLS" "~/.claude/skills"
CURRENT_CATEGORY="codex"
check_skill_exposure_dir "Codex" "$CODEX_SKILLS" "~/.codex/skills"
CURRENT_CATEGORY="kimi"
check_skill_exposure_dir "Kimi Code" "$KIMI_SKILLS" "\$KIMI_CODE_HOME/skills"
CURRENT_CATEGORY="opencode"
check_opencode_command_dir "$OPENCODE_COMMANDS" "~/.config/opencode/commands"
check_opencode_cli
CURRENT_CATEGORY="kimi"
check_kimi_host

# 5. Working tree clean
CURRENT_CATEGORY="framework"
echo ""
echo "─── 5. ~/.pmai/ working tree ───"
if [ -d "$PMAI_HOME/.git" ]; then
  cd "$PMAI_HOME"
  if ! GIT_STATUS=$(git status --porcelain 2>/dev/null); then
    warn "Working tree state could not be read"
  elif [ -z "$GIT_STATUS" ]; then
    FRAMEWORK_WORKTREE="clean"
    ok "Working tree clean"
  else
    FRAMEWORK_WORKTREE="dirty"
    warn "Working tree dirty — uncommitted changes in ~/.pmai/ 影响所有消费仓行为"
  fi
fi

# 6. Remote currentness
CURRENT_CATEGORY="upgrade"
echo ""
echo "─── 6. Remote currentness ───"
if [ -d "$PMAI_HOME/.git" ]; then
  cd "$PMAI_HOME"
  REMOTE_URL=$(git remote get-url origin 2>/dev/null || echo "")
  FRAMEWORK_REMOTE_URL="$REMOTE_URL"
  if [ -z "$REMOTE_URL" ]; then
    warn "No origin remote configured (升级会失败)"
  else
    REMOTE_MAIN=$(timeout 10 git ls-remote --heads origin refs/heads/main 2>/dev/null)
    REMOTE_RC=$?
    if [ "$REMOTE_RC" = "0" ]; then
      read -r FRAMEWORK_REMOTE_HEAD _ <<< "$REMOTE_MAIN"
      if [ -z "$FRAMEWORK_REMOTE_HEAD" ]; then
        warn "Remote $REMOTE_URL has no refs/heads/main"
      elif [ -n "$FRAMEWORK_HEAD" ] && [ "$FRAMEWORK_HEAD" = "$FRAMEWORK_REMOTE_HEAD" ]; then
        UPDATE_AVAILABLE="false"
        ok "Framework matches remote main (${FRAMEWORK_HEAD:0:7})"
      else
        UPDATE_AVAILABLE="true"
        warn "Framework differs from remote main; run /pmai-upgrade"
      fi
    else
      warn "Remote $REMOTE_URL unreachable (SSH key / network / repo access?)"
    fi
  fi
fi

project_has_legacy_copy() {
  local root="$1"
  local entry

  if [ -f "$root/.framework-sync-state.json" ] \
    || [ -f "$root/.claude/scripts/status-view.py" ] \
    || [ -f "$root/.claude/scripts/init-project.sh" ]; then
    return 0
  fi
  for entry in "$root"/.claude/skills/pmai-* "$root"/.codex/skills/pmai-*; do
    if [ -e "$entry" ] || [ -L "$entry" ]; then
      return 0
    fi
  done
  return 1
}

project_has_consumer_marker() {
  local root="$1"

  [ -f "$root/PRODUCT-STATE.md" ] && return 0
  [ -f "$root/docs/CONTEXT.md" ] && return 0
  [ -f "$root/.pm-workflow/config.yml" ] && return 0
  [ -f "$root/.codex/hooks.json" ] && return 0
  [ -f "$root/.opencode/commands/pmai-build.md" ] && return 0
  if [ -f "$root/AGENTS.md" ] \
    && grep -qE 'PMAI|/pmai-' "$root/AGENTS.md" 2>/dev/null; then
    return 0
  fi
  if [ -f "$root/CLAUDE.md" ] \
    && grep -qE 'PMAI|/pmai-' "$root/CLAUDE.md" 2>/dev/null; then
    return 0
  fi
  return 1
}

find_non_git_consumer_root() {
  local candidate="$1"

  while [ -n "$candidate" ] && [ "$candidate" != "/" ]; do
    if project_has_consumer_marker "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
    candidate=$(dirname "$candidate")
  done
  return 1
}

run_consumer_topology_check() {
  local checker rc status phase finding_level finding_message

  checker="$PMAI_HOME/scripts/consumer-doctor.py"
  if [ ! -f "$checker" ]; then
    CURRENT_CATEGORY="framework"
    fail "消费仓结构检查器缺失：$checker"
    CURRENT_CATEGORY="consumer"
    return 0
  fi
  CONSUMER_AUDIT_FILE=$(mktemp "${TMPDIR:-/tmp}/pmai-consumer-audit.XXXXXX") || {
    CURRENT_CATEGORY="framework"
    fail "无法创建消费仓诊断临时文件"
    CURRENT_CATEGORY="consumer"
    return 0
  }
  python3 "$checker" --repo-root "$PROJECT_ROOT" > "$CONSUMER_AUDIT_FILE" 2>/dev/null
  rc=$?
  if ! python3 - "$CONSUMER_AUDIT_FILE" <<'PY' >/dev/null 2>&1
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    payload = json.load(handle)
if not isinstance(payload, dict) or payload.get("schema_version") != 1:
    raise SystemExit(1)
if payload.get("status") not in {"current", "sync_required", "invalid"}:
    raise SystemExit(1)
findings = payload.get("findings")
if not isinstance(findings, list):
    raise SystemExit(1)
valid_kinds = {
    "framework_managed_sync",
    "legacy_compatible",
    "compatibility_declaration_required",
    "project_content_invalid",
    "project_advisory",
}
for finding in findings:
    if not isinstance(finding, dict):
        raise SystemExit(1)
    if finding.get("level") not in {"error", "sync", "warning"}:
        raise SystemExit(1)
    if finding.get("kind") not in valid_kinds:
        raise SystemExit(1)
    if not isinstance(finding.get("blocking"), bool):
        raise SystemExit(1)
    if not isinstance(finding.get("message"), str):
        raise SystemExit(1)
blocking = any(finding["blocking"] for finding in findings)
sync_required = any(
    finding["kind"] in {"framework_managed_sync", "compatibility_declaration_required"}
    for finding in findings
)
expected_status = "invalid" if blocking else "sync_required" if sync_required else "current"
if payload["status"] != expected_status:
    raise SystemExit(1)
PY
  then
    CURRENT_CATEGORY="framework"
    fail "消费仓结构检查器没有返回可用的 schema v1 JSON"
    CURRENT_CATEGORY="consumer"
    return 0
  fi
  if [ "$rc" != "0" ] && [ "$rc" != "2" ]; then
    CURRENT_CATEGORY="framework"
    fail "消费仓结构检查器异常退出：$rc"
    CURRENT_CATEGORY="consumer"
    return 0
  fi

  CONSUMER_TOPOLOGY=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["status"])' "$CONSUMER_AUDIT_FILE")
  CONSUMER_PHASE=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["phase"])' "$CONSUMER_AUDIT_FILE")
  while IFS=$'\t' read -r finding_level finding_message; do
    [ -n "$finding_level" ] || continue
    case "$finding_level" in
      error) fail "$finding_message" ;;
      sync|warning) warn "$finding_message" ;;
      *)
        CURRENT_CATEGORY="framework"
        fail "消费仓结构检查器返回未知 finding level"
        CURRENT_CATEGORY="consumer"
        ;;
    esac
  done < <(python3 - "$CONSUMER_AUDIT_FILE" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    findings = json.load(handle)["findings"]
for finding in findings:
    level = str(finding.get("level") or "").replace("\t", " ").replace("\n", " ")
    message = str(finding.get("message") or "").replace("\t", " ").replace("\n", " ")
    print(f"{level}\t{message}")
PY
  )
  if [ "$CONSUMER_TOPOLOGY" = "current" ]; then
    ok "Consumer structure matches the installed framework contract ($CONSUMER_PHASE)"
  fi
}

check_current_project() {
  local manager opencode_manager git_hook_manager rc candidate

  [ -n "$DOCTOR_START_CWD" ] || return 0
  PROJECT_ROOT=$(git -C "$DOCTOR_START_CWD" rev-parse --show-toplevel 2>/dev/null || true)
  if [ -z "$PROJECT_ROOT" ]; then
    candidate=$(find_non_git_consumer_root "$DOCTOR_START_CWD" || true)
    [ -n "$candidate" ] || return 0
    PROJECT_ROOT="$candidate"
  fi
  PROJECT_ROOT=$(cd "$PROJECT_ROOT" 2>/dev/null && pwd -P) || {
    PROJECT_ROOT=""
    return 0
  }

  if [ -f "$PROJECT_ROOT/RUNTIME.md" ] \
    && [ -f "$PROJECT_ROOT/skills/init-project/SKILL.md" ] \
    && [ -f "$PROJECT_ROOT/CLAUDE.md" ]; then
    PROJECT_KIND="generator"
    PROJECT_HOOKS="not_applicable"
    PROJECT_OPENCODE="not_applicable"
    PROJECT_GIT_HOOK="not_applicable"
    ok "Current repository is the PMAI generator; consumer checks skipped"
    return 0
  fi
  if ! project_has_consumer_marker "$PROJECT_ROOT"; then
    PROJECT_KIND="other"
    PROJECT_HOOKS="not_applicable"
    PROJECT_OPENCODE="not_applicable"
    PROJECT_GIT_HOOK="not_applicable"
    ok "Current repository is not a PMAI consumer; consumer checks skipped"
    return 0
  fi

  PROJECT_KIND="consumer"
  if project_has_legacy_copy "$PROJECT_ROOT"; then
    LEGACY_LOCAL_COPY="true"
    warn "Current consumer has legacy project-local PMAI copies; remove them with pmai uninstall --local"
  else
    ok "No legacy project-local PMAI copies detected"
  fi

  manager="$PMAI_HOME/scripts/install-project-hooks.sh"
  if [ ! -f "$manager" ]; then
    PROJECT_HOOKS="checker_missing"
    warn "Project hook checker is missing; upgrade PMAI before checking this consumer"
  else
    (cd "$PROJECT_ROOT" && PMAI_HOME="$PMAI_HOME" bash "$manager" --check) >/dev/null 2>&1
    rc=$?
    case "$rc" in
      0)
        PROJECT_HOOKS="current"
        ok "Current consumer project hooks match the installed framework"
        ;;
      1)
        PROJECT_HOOKS="drifted"
        warn "Current consumer project hooks need refresh"
        ;;
      *)
        PROJECT_HOOKS="invalid"
        warn "Current consumer project hooks are invalid or unreadable"
        ;;
    esac
  fi

  opencode_manager="$PMAI_HOME/scripts/install-opencode-commands.sh"
  if [ ! -f "$opencode_manager" ]; then
    PROJECT_OPENCODE="checker_missing"
    warn "OpenCode project checker is missing; upgrade PMAI before checking this consumer"
  elif PMAI_HOME="$PMAI_HOME" bash "$opencode_manager" \
    --project "$PROJECT_ROOT" --check >/dev/null 2>&1; then
    PROJECT_OPENCODE="current"
    ok "Current consumer OpenCode entries match the installed framework"
  else
    rc=$?
    if [ "$rc" = "1" ]; then
      PROJECT_OPENCODE="drifted"
      warn "Current consumer OpenCode entries need refresh"
    else
      PROJECT_OPENCODE="invalid"
      warn "Current consumer OpenCode entries are invalid or unreadable"
    fi
  fi

  git_hook_manager="$PMAI_HOME/scripts/install-hooks.sh"
  if [ ! -f "$git_hook_manager" ]; then
    PROJECT_GIT_HOOK="checker_missing"
    warn "Git hook checker is missing; upgrade PMAI before checking this consumer"
  elif (cd "$PROJECT_ROOT" && PMAI_HOME="$PMAI_HOME" bash "$git_hook_manager" --check) >/dev/null 2>&1; then
    PROJECT_GIT_HOOK="current"
    ok "Current consumer Git hook matches the installed framework"
  else
    rc=$?
    if [ "$rc" = "1" ]; then
      PROJECT_GIT_HOOK="drifted"
      warn "Current consumer Git hook needs refresh"
    else
      PROJECT_GIT_HOOK="invalid"
      warn "Current consumer Git hook is invalid or unreadable"
    fi
  fi

  run_consumer_topology_check
}

CURRENT_CATEGORY="consumer"
echo ""
echo "─── 7. Current repository ───"
check_current_project

# 8. Claude Code Bash 工具子进程 PATH
CURRENT_CATEGORY="runtime"
#
# Claude Code 的 Bash 工具开 bash 子进程（不读 zsh 的 .zshrc），macOS 上
# login bash 读 .bash_profile。zsh 用户在 terminal 加完 PATH 之后，chat 里
# 跑 pmai 仍可能 not found —— 这个检测把盲点暴露出来。
echo ""
echo "─── 8. Claude Code Bash 工具子进程 PATH ───"
if bash -lc 'command -v pmai >/dev/null 2>&1'; then
  ok "bash -lc 能调到 pmai（Claude Code 内 AI 可调）"
else
  # 算修复目标 rc：macOS 上 login bash 优先 .bash_profile
  if [ -f "$HOME/.bash_profile" ]; then
    FIX_RC="$HOME/.bash_profile"
  elif [ -f "$HOME/.bashrc" ]; then
    FIX_RC="$HOME/.bashrc"
  else
    FIX_RC="$HOME/.bash_profile"
  fi
  warn "bash -lc 调不到 pmai — Claude Code 内 AI 跑 pmai 会 not found"
  echo "      修复：echo 'export PATH=\"\$HOME/.pmai/bin:\$PATH\"' >> $FIX_RC"
fi

# 9. gstack readiness
CURRENT_CATEGORY="browser"
echo ""
echo "─── 9. gstack prerequisite ───"
GSTACK_BIN=$(command -v gstack 2>/dev/null || true)
if [ -n "$GSTACK_BIN" ]; then
  ok "gstack command found: $GSTACK_BIN"
elif [ -d "$HOME/.claude/skills/gstack" ]; then
  if [ -f "$HOME/.claude/skills/gstack/VERSION" ]; then
    ok "gstack skill found at ~/.claude/skills/gstack ($(cat "$HOME/.claude/skills/gstack/VERSION" 2>/dev/null || echo unknown))"
  else
    ok "gstack skill found at ~/.claude/skills/gstack"
  fi
else
  warn "gstack 未检测到 — 初始化和非 Web build 不受影响；Web 验收需使用 gstack 或其它主动浏览器适配器；参考：https://github.com/garrytan/gstack"
fi

# 10. gstack browser/design diagnostics
echo ""
echo "─── 10. gstack browser/design diagnostics ───"
GSTACK_BROWSER_CHECK="$PMAI_HOME/scripts/check-gstack-browser.sh"
if [ -f "$GSTACK_BROWSER_CHECK" ]; then
  if [ "$BROWSER_SMOKE" = "1" ]; then
    if bash "$GSTACK_BROWSER_CHECK" --browser-smoke; then
      ok "active gstack browser smoke passed"
    else
      fail "active gstack browser smoke failed — browser-backed visual/behavior audits cannot be treated as passed"
    fi
  elif bash "$GSTACK_BROWSER_CHECK" --doctor; then
    ok "passive gstack browser/design diagnostics passed (active smoke not run)"
  else
    warn "gstack browser/design diagnostics reported warnings — this may be a Codex sandbox localhost restriction, not a broken gstack install"
  fi
else
  warn "gstack browser diagnostic script missing at $GSTACK_BROWSER_CHECK — run pmai upgrade to install the latest diagnostics"
fi

echo ""
echo "════════════════════════════════════════════════════════════"
if [ "$EXIT_CODE" = "0" ] && [ "$WARN_COUNT" = "0" ]; then
  echo "Result: ✅ ALL OK ($PASS_COUNT checks passed)"
elif [ "$EXIT_CODE" = "0" ]; then
  echo "Result: ⚠️  OK with warnings ($PASS_COUNT pass / $WARN_COUNT warn)"
else
  echo "Result: ❌ FAIL ($FAIL_COUNT fail / $WARN_COUNT warn / $PASS_COUNT pass)"
fi
echo "════════════════════════════════════════════════════════════"

finish_doctor "$EXIT_CODE"
