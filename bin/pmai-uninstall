#!/usr/bin/env bash
# pmai-uninstall — Remove PMAI framework install
#
# What gets removed:
#   ~/.pmai/                      framework source (git clone)
#   ~/.pmai-state/                配置 + cache + just-upgraded marker（--keep-state 保留）
#   ~/.claude/skills/pmai-*       global Claude skill symlinks
#   ~/.claude/skills/_shared      (if it's a symlink we created)
#   ~/.codex/skills/pmai-*        global Codex skill symlinks
#   ~/.codex/skills/_shared       (if it's a symlink we created)
#   ~/.codex/prompts/pmai-*.md    legacy Codex slash prompt files（兼容清理）
#   ~/.kimi-code/skills/pmai-*    Kimi Code native skill symlinks
#   ~/.kimi-code/config.toml      只移除 PMAI 托管的 Kimi hooks block
#   ~/.config/opencode/commands/pmai-*.md OpenCode slash command files
#
# What is NOT removed:
#   项目里的遗留实体副本 → 单独用 `pmai uninstall --local <dir>` 清
#   项目级 .claude/settings.json / .codex/hooks.json / .opencode/commands / opencode.json 不动（host 配置注册在消费仓内）
#
# Flags:
#   --force                       不问确认（preview 仍打印）
#   --keep-state                  保留 ~/.pmai-state/ 配置 / cache（重装时偏好不丢）
#   --local <dir>                 清理遗留项目副本（旧 install --local 已移除；此项专供迁移清场）

set -uo pipefail  # 注意：no -e，uninstall 必须能跑完

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! source "$SCRIPT_DIR/../scripts/_lib/skill-links.sh"; then
  echo "❌ 无法载入 skill 入口策略，拒绝卸载。" >&2
  exit 2
fi
if ! source "$SCRIPT_DIR/../scripts/_lib/global-install-lock.sh"; then
  echo "❌ 无法载入全局安装锁 helper，拒绝卸载。" >&2
  exit 2
fi
ORIGINAL_ARGS=("$@")

PMAI_HOME="${PMAI_HOME:-$HOME/.pmai}"
PMAI_STATE="${PMAI_STATE:-$HOME/.pmai-state}"
CLAUDE_SKILLS="$HOME/.claude/skills"
CODEX_SKILLS="${CODEX_HOME:-$HOME/.codex}/skills"
CODEX_PROMPTS="${CODEX_HOME:-$HOME/.codex}/prompts"
KIMI_CODE_HOME="${KIMI_CODE_HOME:-$HOME/.kimi-code}"
KIMI_SKILLS="$KIMI_CODE_HOME/skills"
KIMI_CONFIG="$KIMI_CODE_HOME/config.toml"
OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
OPENCODE_COMMANDS="$OPENCODE_CONFIG_DIR/commands"
SKILL_PREFIX="pmai-"

usage() {
  cat <<EOF
Usage:
  pmai uninstall                # Preview + [y/N] confirm + remove global install
  pmai uninstall --force        # Skip [y/N]（preview 仍打印）
  pmai uninstall --keep-state   # 保留 ~/.pmai-state/（config / cache / marker）
  pmai uninstall --local <dir>  # 清理遗留项目副本（迁移用），~/.pmai/ 全局不动

Removed:
  ~/.pmai/
  ~/.pmai-state/         (unless --keep-state)
  ~/.claude/skills/pmai-*
  ~/.claude/skills/_shared (if pmai-managed symlink)
  ~/.codex/skills/pmai-*
  ~/.codex/skills/_shared  (if pmai-managed symlink)
  ~/.codex/prompts/pmai-*.md (legacy cleanup)
  ~/.kimi-code/skills/pmai-*
  ~/.kimi-code/config.toml 中的 PMAI managed Kimi Code hooks block
  ~/.config/opencode/commands/pmai-*.md
EOF
}

FORCE=0
KEEP_STATE=0
LOCAL_DIR=""
MODE="global"

while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --force) FORCE=1; shift ;;
    --keep-state) KEEP_STATE=1; shift ;;
    --local)
      shift
      LOCAL_DIR="${1:-}"
      [ -z "$LOCAL_DIR" ] && { echo "❌ --local needs <dir>" >&2; exit 2; }
      MODE="local"
      shift
      ;;
    *) echo "❌ unknown flag: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [ "$MODE" = "global" ]; then
  pmai_hold_global_install_lock \
    "$SCRIPT_DIR/.." "${BASH_SOURCE[0]}" \
    ${ORIGINAL_ARGS[@]+"${ORIGINAL_ARGS[@]}"} || exit $?
fi

confirm() {
  [ "$FORCE" = "1" ] && return 0
  printf "%s [y/N] " "$1"
  read -r ans
  case "$ans" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

# ─── --local 模式 ─────────────────────────────────────────────
if [ "$MODE" = "local" ]; then
  LOCAL_DIR=$(cd "$LOCAL_DIR" 2>/dev/null && pwd || echo "$LOCAL_DIR")
  echo "→ Local uninstall target: $LOCAL_DIR"
  REMOVED=0
  for sub in scripts agents skills; do
    p="$LOCAL_DIR/.claude/$sub"
    if [ -e "$p" ] || [ -L "$p" ]; then
      if [ "$sub" = "skills" ]; then
        for s in "$p"/${SKILL_PREFIX}* "$p/_shared"; do
          if [ -e "$s" ] || [ -L "$s" ]; then
            if confirm "Remove $s ?"; then
              rm -rf "$s"
              REMOVED=$((REMOVED + 1))
            fi
          fi
        done
      else
        if confirm "Remove $p ?"; then
          rm -rf "$p"
          REMOVED=$((REMOVED + 1))
        fi
      fi
    fi
  done
  rm -f "$LOCAL_DIR/.claude/.pmai-version" 2>/dev/null
  echo ""
  echo "✅ Local uninstall done. Removed $REMOVED items from $LOCAL_DIR/.claude/"
  exit 0
fi

# ─── 全局卸载：详细 preview ───────────────────────────────────
echo "════════════════════════════════════════════════════════════"
echo "  pmai uninstall — preview"
echo "════════════════════════════════════════════════════════════"

PMAI_PRESENT=0
if [ -d "$PMAI_HOME" ]; then
  PMAI_PRESENT=1
  VER="(unknown)"
  HEAD="(no-git)"
  if [ -f "$PMAI_HOME/VERSION" ]; then
    VER=$(cat "$PMAI_HOME/VERSION" 2>/dev/null || echo unknown)
  fi
  if [ -d "$PMAI_HOME/.git" ]; then
    HEAD=$(git -C "$PMAI_HOME" rev-parse --short HEAD 2>/dev/null || echo unknown)
  fi
  SIZE=$(du -sh "$PMAI_HOME" 2>/dev/null | awk '{print $1}')
  echo "  ✓ $PMAI_HOME"
  echo "      version: v${VER} @ ${HEAD}"
  echo "      size:    ${SIZE:-?}"
else
  echo "  - $PMAI_HOME (not installed)"
fi

STATE_PRESENT=0
if [ -d "$PMAI_STATE" ]; then
  STATE_PRESENT=1
  STATE_ITEMS=$(ls -A "$PMAI_STATE" 2>/dev/null | head -5 | tr '\n' ' ')
  if [ "$KEEP_STATE" = "1" ]; then
    echo "  - $PMAI_STATE (KEPT, --keep-state set)"
    echo "      contents: ${STATE_ITEMS:-empty}"
  else
    echo "  ✓ $PMAI_STATE"
    echo "      contents: ${STATE_ITEMS:-empty}"
  fi
else
  echo "  - $PMAI_STATE (not present)"
fi

CLAUDE_SYMLINKS=()
for s in "$CLAUDE_SKILLS"/${SKILL_PREFIX}*; do
  [ -L "$s" ] && CLAUDE_SYMLINKS+=("$s")
done
[ -L "$CLAUDE_SKILLS/_shared" ] \
  && pmai_shared_link_is_managed "$PMAI_HOME/skills/_shared" "$CLAUDE_SKILLS/_shared" \
  && CLAUDE_SYMLINKS+=("$CLAUDE_SKILLS/_shared")
CODEX_SYMLINKS=()
for s in "$CODEX_SKILLS"/${SKILL_PREFIX}*; do
  [ -L "$s" ] && CODEX_SYMLINKS+=("$s")
done
[ -L "$CODEX_SKILLS/_shared" ] \
  && pmai_shared_link_is_managed "$PMAI_HOME/skills/_shared" "$CODEX_SKILLS/_shared" \
  && CODEX_SYMLINKS+=("$CODEX_SKILLS/_shared")
KIMI_SYMLINKS=()
for s in "$KIMI_SKILLS"/${SKILL_PREFIX}*; do
  [ -L "$s" ] && KIMI_SYMLINKS+=("$s")
done
[ -L "$KIMI_SKILLS/_shared" ] \
  && pmai_shared_link_is_managed "$PMAI_HOME/skills/_shared" "$KIMI_SKILLS/_shared" \
  && KIMI_SYMLINKS+=("$KIMI_SKILLS/_shared")
CLAUDE_SYMLINK_COUNT=${#CLAUDE_SYMLINKS[@]}
CODEX_SYMLINK_COUNT=${#CODEX_SYMLINKS[@]}
KIMI_SYMLINK_COUNT=${#KIMI_SYMLINKS[@]}
SYMLINKS=()
if [ "$CLAUDE_SYMLINK_COUNT" -gt 0 ]; then
  SYMLINKS+=("${CLAUDE_SYMLINKS[@]}")
fi
if [ "$CODEX_SYMLINK_COUNT" -gt 0 ]; then
  SYMLINKS+=("${CODEX_SYMLINKS[@]}")
fi
if [ "$KIMI_SYMLINK_COUNT" -gt 0 ]; then
  SYMLINKS+=("${KIMI_SYMLINKS[@]}")
fi
SYMLINK_COUNT=${#SYMLINKS[@]}
CODEX_PROMPT_FILES=()
for s in "$CODEX_PROMPTS"/${SKILL_PREFIX}*.md; do
  [ -e "$s" ] && CODEX_PROMPT_FILES+=("$s")
done
CODEX_PROMPT_COUNT=${#CODEX_PROMPT_FILES[@]}
OPENCODE_COMMAND_FILES=()
for s in "$OPENCODE_COMMANDS"/${SKILL_PREFIX}*.md; do
  [ -e "$s" ] && OPENCODE_COMMAND_FILES+=("$s")
done
OPENCODE_COMMAND_COUNT=${#OPENCODE_COMMAND_FILES[@]}
KIMI_HOOKS_PRESENT=0
if [ -f "$KIMI_CONFIG" ] && grep -q '^# >>> PMAI managed Kimi Code hooks >>>$' "$KIMI_CONFIG" 2>/dev/null; then
  KIMI_HOOKS_PRESENT=1
fi
echo "  ✓ $CLAUDE_SKILLS/${SKILL_PREFIX}* ($CLAUDE_SYMLINK_COUNT symlinks)"
if [ "$CLAUDE_SYMLINK_COUNT" -gt 0 ] && [ "$CLAUDE_SYMLINK_COUNT" -le 10 ]; then
  for s in "${CLAUDE_SYMLINKS[@]}"; do
    echo "      - $(basename "$s")"
  done
elif [ "$CLAUDE_SYMLINK_COUNT" -gt 10 ]; then
  for s in "${CLAUDE_SYMLINKS[@]:0:5}"; do
    echo "      - $(basename "$s")"
  done
  echo "      … (+$((CLAUDE_SYMLINK_COUNT - 5)) more)"
fi
echo "  ✓ $CODEX_SKILLS/${SKILL_PREFIX}* ($CODEX_SYMLINK_COUNT symlinks)"
if [ "$CODEX_SYMLINK_COUNT" -gt 0 ] && [ "$CODEX_SYMLINK_COUNT" -le 10 ]; then
  for s in "${CODEX_SYMLINKS[@]}"; do
    echo "      - $(basename "$s")"
  done
elif [ "$CODEX_SYMLINK_COUNT" -gt 10 ]; then
  for s in "${CODEX_SYMLINKS[@]:0:5}"; do
    echo "      - $(basename "$s")"
  done
  echo "      … (+$((CODEX_SYMLINK_COUNT - 5)) more)"
fi
echo "  ✓ $KIMI_SKILLS/${SKILL_PREFIX}* ($KIMI_SYMLINK_COUNT symlinks)"
if [ "$KIMI_SYMLINK_COUNT" -gt 0 ] && [ "$KIMI_SYMLINK_COUNT" -le 10 ]; then
  for s in "${KIMI_SYMLINKS[@]}"; do
    echo "      - $(basename "$s")"
  done
elif [ "$KIMI_SYMLINK_COUNT" -gt 10 ]; then
  for s in "${KIMI_SYMLINKS[@]:0:5}"; do
    echo "      - $(basename "$s")"
  done
  echo "      … (+$((KIMI_SYMLINK_COUNT - 5)) more)"
fi
if [ "$KIMI_HOOKS_PRESENT" = "1" ]; then
  echo "  ✓ $KIMI_CONFIG (remove PMAI-managed hooks only)"
else
  echo "  - $KIMI_CONFIG (no PMAI-managed hooks)"
fi
echo "  ✓ $CODEX_PROMPTS/${SKILL_PREFIX}*.md ($CODEX_PROMPT_COUNT legacy prompt files)"
if [ "$CODEX_PROMPT_COUNT" -gt 0 ] && [ "$CODEX_PROMPT_COUNT" -le 10 ]; then
  for s in "${CODEX_PROMPT_FILES[@]}"; do
    echo "      - $(basename "$s")"
  done
elif [ "$CODEX_PROMPT_COUNT" -gt 10 ]; then
  for s in "${CODEX_PROMPT_FILES[@]:0:5}"; do
    echo "      - $(basename "$s")"
  done
  echo "      … (+$((CODEX_PROMPT_COUNT - 5)) more)"
fi
echo "  ✓ $OPENCODE_COMMANDS/${SKILL_PREFIX}*.md ($OPENCODE_COMMAND_COUNT command files)"
if [ "$OPENCODE_COMMAND_COUNT" -gt 0 ] && [ "$OPENCODE_COMMAND_COUNT" -le 10 ]; then
  for s in "${OPENCODE_COMMAND_FILES[@]}"; do
    echo "      - $(basename "$s")"
  done
elif [ "$OPENCODE_COMMAND_COUNT" -gt 10 ]; then
  for s in "${OPENCODE_COMMAND_FILES[@]:0:5}"; do
    echo "      - $(basename "$s")"
  done
  echo "      … (+$((OPENCODE_COMMAND_COUNT - 5)) more)"
fi

echo ""
echo "NOT removed:"
echo "  - 项目里遗留的实体副本；用 'pmai uninstall --local <dir>' 单独清"
echo "  - 消费仓内 .claude/settings.json / .codex/hooks.json / .opencode/commands / opencode.json（项目自管）"
[ "$KEEP_STATE" = "1" ] && echo "  - ~/.pmai-state/ (--keep-state)"

echo ""
echo "════════════════════════════════════════════════════════════"

if [ "$PMAI_PRESENT" = "0" ] && [ "$SYMLINK_COUNT" = "0" ] && [ "$CODEX_PROMPT_COUNT" = "0" ] && [ "$OPENCODE_COMMAND_COUNT" = "0" ] && [ "$KIMI_HOOKS_PRESENT" = "0" ] && [ "$STATE_PRESENT" = "0" ]; then
  echo "⚠️  没找到 PMAI 全局安装。已经卸载或从未安装。"
  exit 0
fi

confirm "Continue?" || { echo "Aborted."; exit 0; }

# ─── 真删 ─────────────────────────────────────────────────────
echo ""
REMOVED_COUNT=0

# 清 skill symlink
if [ "$SYMLINK_COUNT" -gt 0 ]; then
  for s in "${SYMLINKS[@]}"; do
    rm -f "$s" && REMOVED_COUNT=$((REMOVED_COUNT + 1))
  done
fi
REMOVED_PROMPT_COUNT=0
if [ "$CODEX_PROMPT_COUNT" -gt 0 ]; then
  for s in "${CODEX_PROMPT_FILES[@]}"; do
    rm -f "$s" && REMOVED_PROMPT_COUNT=$((REMOVED_PROMPT_COUNT + 1))
  done
fi
REMOVED_OPENCODE_COMMAND_COUNT=0
if [ "$OPENCODE_COMMAND_COUNT" -gt 0 ]; then
  for s in "${OPENCODE_COMMAND_FILES[@]}"; do
    rm -f "$s" && REMOVED_OPENCODE_COMMAND_COUNT=$((REMOVED_OPENCODE_COMMAND_COUNT + 1))
  done
fi
REMOVED_KIMI_HOOKS=0
KIMI_HOOK_MANAGER="$PMAI_HOME/scripts/manage-kimi-hooks.py"
if [ ! -f "$KIMI_HOOK_MANAGER" ]; then
  KIMI_HOOK_MANAGER="$(cd "$(dirname "$0")/.." && pwd)/scripts/manage-kimi-hooks.py"
fi
if [ "$KIMI_HOOKS_PRESENT" = "1" ] && [ -f "$KIMI_HOOK_MANAGER" ]; then
  if KIMI_CODE_HOME="$KIMI_CODE_HOME" python3 "$KIMI_HOOK_MANAGER" remove --config "$KIMI_CONFIG" >/dev/null 2>&1; then
    REMOVED_KIMI_HOOKS=1
  else
    echo "⚠️  未能从 $KIMI_CONFIG 移除 PMAI Kimi hooks；保留该文件供手动检查。" >&2
  fi
fi
# 老实体目录残留（罕见 — install 路径几乎不会创建实体）警告不删
for s in "$CLAUDE_SKILLS"/${SKILL_PREFIX}* "$CLAUDE_SKILLS/_shared"; do
  if [ -d "$s" ] && [ ! -L "$s" ]; then
    echo "⚠️  $s 是实体目录不是 symlink，跳过（手动清）" >&2
  fi
done
for s in "$CODEX_SKILLS"/${SKILL_PREFIX}* "$CODEX_SKILLS/_shared"; do
  if [ -d "$s" ] && [ ! -L "$s" ]; then
    echo "⚠️  $s 是实体目录不是 symlink，跳过（手动清）" >&2
  fi
done
for s in "$KIMI_SKILLS"/${SKILL_PREFIX}* "$KIMI_SKILLS/_shared"; do
  if [ -d "$s" ] && [ ! -L "$s" ]; then
    echo "⚠️  $s 是实体目录不是 symlink，跳过（手动清）" >&2
  fi
done

# 清 ~/.pmai/
if [ -d "$PMAI_HOME" ]; then
  rm -rf "$PMAI_HOME"
fi

# 清 ~/.pmai-state/（除非 --keep-state）
if [ "$KEEP_STATE" = "0" ] && [ -d "$PMAI_STATE" ]; then
  rm -rf "$PMAI_STATE"
fi

echo "═══════════════════════════════════════"
echo "✅ PMAI uninstalled globally"
echo "   ~/.pmai/ removed"
if [ "$KEEP_STATE" = "1" ]; then
  echo "   ~/.pmai-state/ KEPT (--keep-state)"
else
  [ "$STATE_PRESENT" = "1" ] && echo "   ~/.pmai-state/ removed"
fi
echo "   host skill symlinks removed ($REMOVED_COUNT total)"
echo "     ~/.claude/skills/pmai-* ($CLAUDE_SYMLINK_COUNT)"
echo "     ~/.codex/skills/pmai-*  ($CODEX_SYMLINK_COUNT)"
echo "     $KIMI_SKILLS/pmai-* ($KIMI_SYMLINK_COUNT)"
echo "   legacy Codex slash prompts removed ($REMOVED_PROMPT_COUNT)"
echo "   OpenCode slash commands removed ($REMOVED_OPENCODE_COMMAND_COUNT)"
echo "   Kimi Code managed hooks removed ($REMOVED_KIMI_HOOKS)"
echo "═══════════════════════════════════════"
echo "Note: 项目里遗留的实体副本不动。"
echo "      用 'pmai uninstall --local <dir>' 单独清理。"
