{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.pmai/scripts/check-branch.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.pmai/hooks/review-skill-guard.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
