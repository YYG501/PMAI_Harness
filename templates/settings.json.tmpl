{
  "permissions": {
    "allow": [
      "Bash(bash $HOME/.pmai/scripts/*)",
      "Bash(python3 $HOME/.pmai/scripts/*)",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(bun *)",
      "Bash(lsof *)",
      "Bash(kill *)",
      "Skill(*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.pmai/scripts/check-branch.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.pmai/hooks/review-skill-guard.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "executor": {
    "default": "claude-code",
    "models": {
      "codex": "gpt-5.4",
      "cursor-agent": "gemini-3.1-pro"
    },
    "claude_code_model_allowlist": ["opus", "sonnet", "haiku"]
  }
}
