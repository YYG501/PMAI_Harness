{
  "permissions": {
    "allow": [
      "Bash(bash .claude/scripts/*)",
      "Bash(python3 .claude/scripts/*)",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(bun *)",
      "Bash(lsof *)",
      "Bash(kill *)",
      "Skill(*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/check-branch.sh"
          }
        ]
      }
    ]
  },
  "executor": {
    "default": "claude-code",
    "models": {
      "codex": "gpt-5.4",
      "cursor-agent": "gemini-3.1-pro"
    },
    "claude_code_model_allowlist": ["opus", "sonnet", "haiku"]
  }
}
