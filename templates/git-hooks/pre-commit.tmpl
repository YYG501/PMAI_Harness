#!/usr/bin/env bash
# pre-commit hook (PM-AI-Workflow)
# 由 init-project.sh / install-hooks.sh 安装到 .git/hooks/pre-commit。
# 职责：
#   1. 拦截 docs/ 顶层错位文件 (check-docs-toplevel.py，按 CLAUDE.md 「docs/ 归档约定」)
#   2. 对 attachments/ 大文件给出 warning（不阻塞）
#
# 绕过：git commit --no-verify（git 内置；hook 不会被调到）。
#
# I-mini 模式：消费仓内 0 framework 资产，所有 checker 都从 $PMAI_HOME 调用。
# pre-commit 进程未经过 skill-preamble.sh → 自己解析 PMAI_HOME（env 优先 / fallback ~/.pmai/）。

set -e
# 守约：后续 warn-only 段（不该 block commit 的检测）必须以 `|| true` 结尾，
# 否则命令替换 / pipeline 失败会触发 set -e 让 hook silent fail（无 stderr，PM 视角是 commit 莫名失败）。

# 找仓根（worktree 也能处理）
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
  exit 0  # 不在 git 仓里？让 git 自己处理
fi

# --- 0. 解析 PMAI_HOME（I-mini 入口）---
PMAI_HOME="${PMAI_HOME:-$HOME/.pmai}"
if [ ! -d "$PMAI_HOME/scripts" ]; then
  echo "⚠️  pre-commit: PMAI 未安装在 $PMAI_HOME。所有 checker 跳过（fail-open）。" >&2
  echo "    修复：跑 pmai install" >&2
  # fail-open：不阻塞 commit，但跳过后续 checker
  exit 0
fi

# --- 1. docs/ 顶层归档约定检测（防错位 / 重复 / 过期文件积累）---
DOCS_CHECKER="$PMAI_HOME/scripts/check-docs-toplevel.py"
if [ -f "$DOCS_CHECKER" ]; then
  python3 "$DOCS_CHECKER"
fi  # 脚本缺失 fail-open（老消费仓还没 sync 进新 framework 时不应阻塞）

# v5 attachments large file warn (>10MB) — fail-open，仅警告
# `|| true` 守 set -e：命中 attachments 且文件 ≤10MB 时，while body 末 `[ ] && echo`
# 返回 1 → while exit 1 → $() 失败 → 顶部 set -e 触发 silent abort。务必保留。
STAGED_LARGE=$(git diff --cached --name-only --diff-filter=AM \
  | grep -E "/attachments/" \
  | while read -r f; do
      [ -f "$f" ] || continue
      size=$(stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null || echo 0)
      [ "$size" -gt 10485760 ] && echo "$f ($(($size / 1024 / 1024))MB)"
    done) || true
if [ -n "$STAGED_LARGE" ]; then
  echo "⚠️  pre-commit: attachments/ 内有 >10MB 文件即将 commit：" >&2
  echo "$STAGED_LARGE" | sed 's/^/    /' >&2
  echo "   建议：外部引用（PM 自负失联风险），或确认要 commit（继续）。" >&2
  # 不 block commit；仅 warn
fi
