#!/usr/bin/env bash
# pre-commit hook (PM-AI-Workflow)
# 由 init-project.sh / install-hooks.sh 安装到 .git/hooks/pre-commit。
# 职责：
#   1. 拦截绕过 task-transition.py 的 task 状态字段直改 (check-status-direct-edit.py)
#   2. 拦截 docs/ 顶层错位文件 (check-docs-toplevel.py，按 CLAUDE.md 「docs/ 归档约定」)
#
# 绕过：git commit --no-verify（git 内置；hook 不会被调到）。

set -e

# 找仓根（worktree 也能处理）
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
  exit 0  # 不在 git 仓里？让 git 自己处理
fi

# --- 1. task 状态字段直改检测 ---
CHECKER="$REPO_ROOT/.claude/scripts/check-status-direct-edit.py"
if [ ! -f "$CHECKER" ]; then
  # 检测脚本缺失：fail-open（不阻塞 commit）但留 stderr 提示
  echo "⚠️  pre-commit: $CHECKER 缺失，跳过 task 状态字段直改检测。" >&2
  echo "    如需补回：bash .claude/scripts/install-hooks.sh" >&2
else
  python3 "$CHECKER"
fi

# --- 2. docs/ 顶层归档约定检测（防错位 / 重复 / 过期文件积累）---
DOCS_CHECKER="$REPO_ROOT/.claude/scripts/check-docs-toplevel.py"
if [ -f "$DOCS_CHECKER" ]; then
  python3 "$DOCS_CHECKER"
fi  # 脚本缺失 fail-open（老消费仓还没 sync 进新 framework 时不应阻塞）

# v5 attachments large file warn (>10MB) — fail-open，仅警告
STAGED_LARGE=$(git diff --cached --name-only --diff-filter=AM \
  | grep -E "/attachments/" \
  | while read -r f; do
      [ -f "$f" ] || continue
      size=$(stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null || echo 0)
      [ "$size" -gt 10485760 ] && echo "$f ($(($size / 1024 / 1024))MB)"
    done)
if [ -n "$STAGED_LARGE" ]; then
  echo "⚠️  pre-commit: attachments/ 内有 >10MB 文件即将 commit：" >&2
  echo "$STAGED_LARGE" | sed 's/^/    /' >&2
  echo "   建议：外部引用（PM 自负失联风险），或确认要 commit（继续）。" >&2
  # 不 block commit；仅 warn
fi
