# PM-AI-Workflow 消费仓配置
#
# 本文件保存消费仓布局合同和 AI 构建执行器偏好。
# `consumer` 只描述框架识别布局所需的机器信息；产品事实仍在 PRODUCT.md、
# docs/INDEX.md 和模块文档中，不在这里重复维护。
# 项目类型、技术栈、代码入口和运行命令由首次 design 定稿后写入
# `.pm-workflow/project.yml`，不得在这里重复定义。

consumer:
  schema_version: 1
  layout_version: 1
  paths:
    archive: docs/archive
  # 旧模块只有在不能按当前三件套解释时才写兼容项。Fresh init 默认为空；
  # active `.work-meta.json` 始终优先，不能被这里的声明降级。
  compatibility: {}

builder:
  # 新 build 默认组合：独立环境 + 当前主控后台 child 构建。
  # 当前会话直接构建仅作为 PM 明确选择或 child 不可用时的降级后端。
  default_profile: native-child
  prototype_profile: native-child
  product_profile: native-child

  profiles:
    claude-code:
      label: Claude Code
      executor: claude-code
      model: sonnet
      thinking: standard
      permission_mode: bypassPermissions
      timeout_seconds: 900

    codex:
      label: Codex
      executor: codex
      model: gpt-5.4
      thinking: high
      sandbox: workspace-write
      timeout_seconds: 900

    opencode:
      label: OpenCode
      executor: opencode
      model: opencode-go/deepseek-v4-flash
      display_model: deepseek-v4-flash
      thinking: max
      variant: max
      auto: true
      timeout_seconds: 900
