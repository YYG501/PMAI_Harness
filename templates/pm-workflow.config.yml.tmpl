# PM-AI-Workflow 消费仓配置
#
# 本文件只保存 AI 构建执行器偏好。
# 项目类型、技术栈、代码入口和运行命令由首次 design 定稿后写入
# `.pm-workflow/project.yml`，不得在这里重复定义。

builder:
  # /pmai-build 的建造工具推荐档位。框架会先按项目类型和本机可用性给出推荐，
  # PM 在开工确认卡中确认或调整；这里不是每次 build 的最终选择记录。
  default_profile: claude-code
  # 旧消费仓缺这两项时回退 default_profile。
  prototype_profile: claude-code
  product_profile: codex

  profiles:
    claude-code:
      label: Claude Code
      executor: claude-code
      model: sonnet
      thinking: standard
      permission_mode: bypassPermissions
      timeout_seconds: 900

    codex:
      label: Codex
      executor: codex
      model: gpt-5.4
      thinking: high
      sandbox: workspace-write
      timeout_seconds: 900

    cursor-agent:
      label: Cursor Agent
      executor: cursor-agent
      model: gemini-3.1-pro
      thinking: standard
      force: true
      trust_workspace: true
      timeout_seconds: 900

    gemini:
      label: Gemini CLI
      executor: gemini
      model: gemini-3.1-pro
      thinking: high
      yolo: true
      timeout_seconds: 900

    opencode:
      label: OpenCode
      executor: opencode
      model: opencode-go/deepseek-v4-flash
      display_model: deepseek-v4-flash
      thinking: max
      variant: max
      auto: true
      timeout_seconds: 900
