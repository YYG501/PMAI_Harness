# PM-AI-Workflow 消费仓配置
#
# 本文件保存消费仓布局合同和 AI 构建执行器偏好。
# `consumer` 只描述框架识别布局所需的机器信息；产品事实仍在 PRODUCT.md、
# docs/INDEX.md 和模块文档中，不在这里重复维护。
# 项目类型、技术栈、代码入口和运行命令由首次 design 定稿后写入
# `.pm-workflow/project.yml`，不得在这里重复定义。

consumer:
  schema_version: 1
  layout_version: 1
  paths:
    archive: docs/archive
  # 旧模块只有在不能按当前三件套解释时才写兼容项。Fresh init 默认为空；
  # active `.work-meta.json` 始终优先，不能被这里的声明降级。
  compatibility: {}

builder:
  # /pmai-build 的建造工具推荐档位。框架会先按项目类型和本机可用性给出推荐，
  # PM 在开工确认卡中确认或调整；这里不是每次 build 的最终选择记录。
  default_profile: claude-code
  # 旧消费仓缺这两项时回退 default_profile。
  prototype_profile: claude-code
  product_profile: codex

  profiles:
    claude-code:
      label: Claude Code
      executor: claude-code
      model: sonnet
      thinking: standard
      permission_mode: bypassPermissions
      timeout_seconds: 900

    codex:
      label: Codex
      executor: codex
      model: gpt-5.4
      thinking: high
      sandbox: workspace-write
      timeout_seconds: 900

    # 框架也会为缺少该项的旧消费仓补充 Kimi 默认档位；这里显式保留，
    # 方便 PM 查看和按项目覆盖模型参数。
    kimi-code:
      label: Kimi Code
      executor: kimi-code
      model: kimi-code/k3
      display_model: k3
      thinking: adaptive
      auto: true
      timeout_seconds: 900

    cursor-agent:
      label: Cursor Agent
      executor: cursor-agent
      model: gemini-3.1-pro
      thinking: standard
      force: true
      trust_workspace: true
      timeout_seconds: 900

    opencode:
      label: OpenCode
      executor: opencode
      model: opencode-go/deepseek-v4-flash
      display_model: deepseek-v4-flash
      thinking: max
      variant: max
      auto: true
      timeout_seconds: 900
