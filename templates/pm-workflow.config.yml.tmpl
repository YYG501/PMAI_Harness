# PM-AI-Workflow 消费仓配置
#
# 读取者：
# - skills/task-verify  — 起 dev server / 探测端口 / 决定截图工具
# - 后续 hook（待扩展）   — build/typecheck/lint 命令
#
# 改了哪个字段会影响什么：见每段注释。

dev_server:
  # 启动 dev server 的命令；任意 shell 命令（pnpm / npm / yarn / make / ...）
  # task-verify 会用这个命令在 task worktree 内启动 dev server（如未在跑）
  command: pnpm dev

  # 端口探测顺序：task-verify 按列表顺序对 ready_check 发 HTTP，第一个返回 200 的胜出
  # 列表里写你项目实际可能监听的端口；不存在的端口跳过
  ports:
    - 3000
    - 5173
    - 8080

  # 健康检查路径（相对 dev server 根）
  # task-verify 用 curl http://localhost:<port>${ready_check} 判断 dev server 是否 ready
  # 默认 / —— 一般首页 200 就够；后端项目可改 /api/health 之类
  ready_check: /

  # dev server 启动超时（秒）；超时仍未 ready → task-verify 视为 fail
  startup_timeout: 30

verify:
  # 截图 / 浏览器交互工具；当前仅支持 gstack-browse
  # 未来扩展 mcp-playwright / playwright-cli 等再列别的值
  screenshot_tool: gstack-browse

  # 截图分辨率（宽 x 高）
  viewport:
    - 1440
    - 900
