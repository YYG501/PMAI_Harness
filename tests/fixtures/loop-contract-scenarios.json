    {"id": "SCN-R01", "phase": "recovery", "trigger": "final_check 中断且已有部分新鲜证据", "action": "resume_checkpoint", "destination": "final_check", "checkpoint": "run_missing_final_steps_only"},
    {"id": "SCN-R02", "phase": "recovery", "trigger": "实现已 landed 但文档 pending 或 failed", "action": "resume_checkpoint", "destination": "documenting", "checkpoint": "docs_only_no_remerge"},
    {"id": "SCN-R03", "phase": "recovery", "trigger": "多个 active build 都可能匹配当前请求", "action": "await_pm_decision", "destination": "recovery", "checkpoint": "no_mtime_guess"}
  ]
