    "observations": [
      "primary_module_bound",
      "related_modules_classified",
      "single_build_scope_question_presented",
      "unrelated_active_work_excluded"
    ],
    "lifecycle_order": [
      "designing"
    ],
    "stopping_point": "awaiting_primary_build_scope_decision"
  },
  "forbidden": {
    "behaviors": [
      "两个完整规格改完后只给其中一个模糊状态",
      "同时留下多个无范围说明的 build 入口",
      "把仓库其它 active work 当成本轮 build 范围",
      "在主 build 入口未确认时提前进入 ready 或 build"
